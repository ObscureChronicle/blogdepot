---
import AlgoliaSearch from '../../components/AlgoliaSearch.astro';
import ArrowRight from '../../icons/ArrowRight.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts } from '../../utils/content-utils';
import { countPostsByTag, getAllTags, isPinyinIndexTag, sortTagsByName } from '../../utils/data-utils';

const posts = await getAllPosts();

const realTags = getAllTags(posts);
const postCounts = countPostsByTag(posts);

const wikiChildTags = realTags.filter((tag) => isPinyinIndexTag(tag.id));
const nonWikiTags = realTags.filter((tag) => !isPinyinIndexTag(tag.id));
---

<BaseLayout
    title="百科"
    description="Explore tag directory for easy navigation and discovery. Find a wide range of topics, articles, and insights organized by tags, making it effortless to locate the content that interests you most."
    showHeader={false}
>
    <h1 class="mb-6 text-2xl font-serif font-semibold sm:mb-10 sm:text-4xl">百科</h1>
    <div>
        <AlgoliaSearch class="mb-12" />
        <h2
            class="text-xl leading-tight font-serif font-bold group-hover:underline group-hover:decoration-dashed group-hover:underline-offset-4 group-hover:decoration-1 sm:text-2xl mb-6"
        >
            分类检索
        </h2>
        {/* 手机上也排 2 列：分类名都很短，单列时整页长达 4700px */}
        <div class="mb-16 grid grid-cols-2 gap-x-4 gap-y-8 lg:grid-cols-3 sm:mb-20 sm:gap-y-10">
            {
                sortTagsByName(nonWikiTags).map((tag) => {
                    const postCount = postCounts.get(tag.id) ?? 0;
                    return (
                        <a class="flex justify-between items-start group gap-8" href={`/tags/${tag.id}/`}>
                            <div class="min-w-0">
                                <h2 class="text-xl leading-tight font-serif font-medium group-hover:underline group-hover:decoration-dashed group-hover:underline-offset-4 group-hover:decoration-1 sm:text-2xl">
                                    {tag.name}
                                </h2>
                                <div class="mt-1 text-sm leading-normal">{`共 ${postCount} 篇`}</div>
                            </div>
                            <div class="hidden font-serif opacity-0 transition group-hover:opacity-100 sm:inline-flex sm:gap-1 sm:items-center sm:shrink-0 lg:hidden">
                                查看所有文章 <ArrowRight class="fill-current w-4 h-4" />
                            </div>
                        </a>
                    );
                })
            }
        </div>
        <h2
            class="text-xl leading-tight font-serif font-bold group-hover:underline group-hover:decoration-dashed group-hover:underline-offset-4 group-hover:decoration-1 sm:text-2xl mb-6"
        >
            音序检索
        </h2>
        {/* 字母只有一个字，排成紧凑的网格；不再给每个字母一个 h2，页面大纲里只保留「音序检索」 */}
        <ul class="grid grid-cols-4 gap-x-4 gap-y-6 sm:grid-cols-6">
            {
                sortTagsByName(wikiChildTags).map((tag) => {
                    const postCount = postCounts.get(tag.id) ?? 0;
                    return (
                        <li>
                            <a class="group block" href={`/tags/${tag.id}/`}>
                                <span class="block text-xl leading-tight font-serif font-medium group-hover:underline group-hover:decoration-dashed group-hover:underline-offset-4 group-hover:decoration-1 sm:text-2xl">
                                    {tag.name}
                                </span>
                                <span class="mt-1 block text-sm leading-normal">{`共 ${postCount} 篇`}</span>
                            </a>
                        </li>
                    );
                })
            }
        </ul>
    </div>
</BaseLayout>
