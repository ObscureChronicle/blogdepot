---
import type { GetStaticPathsOptions, Page } from 'astro';
import { type CollectionEntry } from 'astro:content';
import Pagination from '../../../components/Pagination.astro';
import PostPreview from '../../../components/PostPreview.astro';
import ProjectPreview from '../../../components/ProjectPreview.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllPosts } from '../../../utils/content-utils';
import { getAllTags, getPostsByTag, isPinyinIndexTag } from '../../../utils/data-utils';
import { sortPostsByTitlePinyin } from '../../../utils/sort-by-pinyin';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
    // 多列布局下每页 24 条（桌面 3 列 × 8 行）。这里不复用 siteConfig.postsPerPage：
    // 那个值同时被 /blog/ 日志列表使用，本次只调整百科标签页，日志列表保持每页 8 条。
    const PAGE_SIZE = 24;

    const posts = await getAllPosts();
    const tags = getAllTags(posts);

    return tags.flatMap((tag) => {
        const filteredPosts = getPostsByTag(posts, tag.id);
        // blog 和 projects 从不共用标签，同一个标签页下的内容永远只属于一种 collection：
        // projects 是百科条目，按标题拼音排序；blog 保留 getAllPosts() 已经排好的日期倒序。
        // 在分页之前排序，确保每一页内部顺序连续，而不是分页后再零散地重排当页内容。
        const sortedPosts = filteredPosts[0]?.collection === 'projects' ? sortPostsByTitlePinyin(filteredPosts) : filteredPosts;
        return paginate(sortedPosts, {
            params: { id: tag.id },
            props: { tag },
            pageSize: PAGE_SIZE
        });
    });
}

type Props = { page: Page<CollectionEntry<'blog'> | CollectionEntry<'projects'>>; tag: { id: string; name: string } };

const { page, tag } = Astro.props;
const blogPosts = page.data.filter((item): item is CollectionEntry<'blog'> => item.collection === 'blog');
const projectPosts = page.data.filter((item): item is CollectionEntry<'projects'> => item.collection === 'projects');
---

<BaseLayout
    title={tag.name}
    description={`Explore a curated collection of blog posts under ${tag.name}`}
    image={{ src: '/title.png', alt: 'The preview of the site' }}
    showHeader={false}
>
    <h1 class="mb-12 text-2xl leading-tight font-serif italic sm:mb-16 sm:text-4xl">"{tag.name}"</h1>
    <div class="grid grid-cols-1 gap-x-4 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
        {blogPosts.map((post) => <PostPreview post={post} />)}
        {projectPosts.map((project) => <ProjectPreview project={project} />)}
    </div>
    <Pagination page={page} basePath={`/tags/${tag.id}`} class="my-16 sm:my-24" />
</BaseLayout>

<script is:inline define:vars={{ tagId: tag.id, contextType: isPinyinIndexTag(tag.id) ? 'pinyin' : 'category' }}>
    // 记录用户是从哪个 tag 列表页进来的，供详情页面包屑组件读取，
    // 拼出「分类：XX」/「音序：X」这一级。见 Breadcrumb.astro。
    function recordBreadcrumbContext() {
        try {
            sessionStorage.setItem('wiki-breadcrumb-context', JSON.stringify({ type: contextType, value: tagId }));
        } catch {
            // sessionStorage 不可用（如隐私模式）时静默跳过
        }
    }

    recordBreadcrumbContext();
    document.addEventListener('astro:page-load', recordBreadcrumbContext);
</script>
