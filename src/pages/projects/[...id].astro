---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import EntryToc from '../../components/EntryToc.astro';
import ProjectPreview from '../../components/ProjectPreview.astro';
import WalineComments from '../../components/WalineComments.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildDisambiguationIndex, findDisambiguation } from '../../utils/disambiguation';
import { formatProjectTitle, getProjectCategory, getProjectCategoryName, groupBy, withNeighbors } from '../../utils/neighbor-utils';
import { sortPostsByTitlePinyin } from '../../utils/sort-by-pinyin';

export async function getStaticPaths() {
    // projects 是百科条目，不讲究发布时间，按标题拼音排序而非日期。
    // 上一篇/下一篇限定在同一个分类标签（非 wiki-X 拼音标签）内，
    // 避免人物、装备、关卡等不同类型的词条按全局拼音顺序随机穿插到彼此中间。
    const projects = await getCollection('projects');
    // 重名词条回链到同名消歧义页（标题完全相同即视为同名）
    const disambiguationIndex = buildDisambiguationIndex(projects.map((p) => ({ id: p.id, title: p.data.title })));

    return [...groupBy(projects, getProjectCategory).values()].flatMap((group) =>
        // 组内按拼音升序：上一篇是拼音更靠前的词条，下一篇更靠后
        withNeighbors(sortPostsByTitlePinyin(group)).map(({ item, prev, next }) => ({
            params: { id: item.id },
            props: {
                project: item,
                prevProject: prev,
                nextProject: next,
                disambiguationId: findDisambiguation({ id: item.id, title: item.data.title }, disambiguationIndex)
            }
        }))
    );
}

type Props = {
    project: CollectionEntry<'projects'>;
    prevProject: CollectionEntry<'projects'> | null;
    nextProject: CollectionEntry<'projects'> | null;
    disambiguationId: string | null;
};

const { project, prevProject, nextProject, disambiguationId } = Astro.props;
const { title, seo, tags } = project.data;
const { Content } = await render(project);
// <title> 带上分类（如「陈到 · 人物」），让站内搜索结果、浏览器标签能区分同名词条；页面上的 h1 仍只显示标题
const categoryName = getProjectCategoryName(project);
const pageTitle = seo?.title ?? formatProjectTitle(title, categoryName);
const pageDescription = seo?.description ?? `《后汉稽异录》百科 · ${categoryName ? `${categoryName}词条` : '词条'}：${title}`;

const breadcrumb = {
    items: [
        { label: '首页', href: '/' },
        { label: '百科', href: '/tags/' }
    ],
    current: title
};
---

<BaseLayout
    title={pageTitle}
    description={pageDescription}
    image={seo?.image}
    pageType="article"
    showHeader={false}
    breadcrumb={breadcrumb}
    breadcrumbOwnTags={tags}
>
    <article class="mb-16 sm:mb-24">
        <header class="mb-8">
            <h1 class="text-3xl leading-tight font-serif font-medium sm:text-5xl sm:leading-tight">{title}</h1>
            {
                disambiguationId && (
                    <p class="disambiguation-note mt-3 text-sm sm:text-base">
                        「{title}」另有同名词条，参见
                        <a href={`/projects/${disambiguationId}/`}>{title}（消歧义）</a>
                    </p>
                )
            }
        </header>
        <EntryToc />
        <div class="max-w-none prose sm:prose-lg font-serif wiki">
            <Content />
        </div>
    </article>
    {
        (prevProject || nextProject) && (
            <div class="my-4 flex justify-between">
                {prevProject && (
                    <div>
                        <h2 class="mb-12 text-xl font-serif font-semibold sm:mb-10 sm:text-2xl">←上一篇</h2>{' '}
                        <ProjectPreview project={prevProject} class="mb-10 sm:mb-12" headingLevel="h3" />
                    </div>
                )}
                {nextProject && (
                    <div>
                        <h2 class="mb-12 text-xl font-serif font-semibold sm:mb-10 sm:text-2xl text-right">下一篇→</h2>{' '}
                        <ProjectPreview project={nextProject} class="mb-10 sm:mb-12 text-right" headingLevel="h3" />
                    </div>
                )}
            </div>
        )
    }
    <WalineComments />
</BaseLayout>

<style>
    /* 消歧义回链：次要文字色 + 百科链接色，颜色取主题变量，亮暗两色自动适配 */
    .disambiguation-note {
        color: color-mix(in srgb, var(--text-main) 72%, transparent);
    }
    .disambiguation-note a {
        color: var(--wiki-link);
        text-decoration: underline;
        text-underline-offset: 3px;
    }
</style>
