---
import { getCollection } from 'astro:content';
import BiliBiliVideoPlayer from '../components/BiliBiliVideoPlayer.astro';
import Button from '../components/Button.astro';
import Hero from '../components/Hero.astro';
import PostPreview from '../components/PostPreview.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import siteConfig from '../data/site-config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSortedBlogPosts } from '../utils/content-utils';
import { sortPostsByTitlePinyin } from '../utils/sort-by-pinyin';

const posts = await getSortedBlogPosts();

// projects 是百科条目，不讲究发布时间，按标题拼音排序而非日期
const projects = sortPostsByTitlePinyin(await getCollection('projects'));
---

<BaseLayout title="後漢・三国物語" description={siteConfig.description} image={siteConfig.image}>
    <Hero />
    {
        projects.length > 0 && (
            <div class="mb-16 sm:mb-24">
                <h2 class="mb-4 text-xl font-serif italic sm:text-2xl">百科</h2>
                {projects.slice(0, 5).map((project) => (
                    <ProjectPreview project={project} class="mb-4 sm:mb-4" headingLevel="h3" />
                ))}
                <div class="mt-4 flex flex-wrap gap-2">
                    <Button href="/tags/" target="_self">
                        所有百科条目
                    </Button>
                    <Button data-random="projects">随机百科条目</Button>
                </div>
            </div>
        )
    }
    {
        posts?.length > 0 && (
            <div class="mb-16 sm:mb-24">
                <h2 class="mb-4 text-xl font-serif italic sm:text-2xl">日志</h2>
                {posts.slice(0, 3).map((post) => (
                    <PostPreview post={post} class="mb-10 sm:mb-12" headingLevel="h3" />
                ))}
                <div class="mt-4 flex flex-wrap gap-2">
                    <Button href="/blog/" target="_self">
                        所有日志
                    </Button>
                    <Button data-random="blog">随机日志</Button>
                </div>
            </div>
        )
    }
    <div>
        <h2 class="mb-4 text-xl font-serif italic sm:text-2xl">攻略+全流程视频</h2>
        <h3 class="mb-4 text-base font-serif sm:mb-4 sm:text-lg text-center">后汉篇</h3>
        <BiliBiliVideoPlayer aid="113916977877284" bvid="BV1nvFLeNEY6" cid="28504950572" page="1" />
        <h3 class="mb-4 text-base font-serif sm:mb-4 sm:text-lg text-center">三国篇</h3>
        <BiliBiliVideoPlayer bvid="BV1CZR9YNEw5" aid="114284650566825" cid="29247604058" />
        <h3 class="mb-4 text-base font-serif sm:mb-4 sm:text-lg text-center">星命诀</h3>
        <BiliBiliVideoPlayer bvid="BV1g7R7BTEd7" aid="116505232612070" cid="38040963285" />
    </div>
    <script>
        import { navigate } from 'astro:transitions/client';
        import type { RandomPaths } from './random-paths.json.ts';

        // 路径池（/random-paths.json）第一次点击时才加载，之后整个会话复用；加载失败下次点击再试
        let pathsPromise: Promise<RandomPaths> | undefined;
        function loadPaths(): Promise<RandomPaths> {
            pathsPromise ??= fetch('/random-paths.json')
                .then((res) => {
                    if (!res.ok) throw new Error(`random-paths.json: HTTP ${res.status}`);
                    return res.json() as Promise<RandomPaths>;
                })
                .catch((error) => {
                    pathsPromise = undefined;
                    throw error;
                });
            return pathsPromise;
        }

        // 事件委托挂在 document 上：模块脚本只执行一次，ClientRouter 换页回首页后按钮依然有效
        document.addEventListener('click', async (event) => {
            const button = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-random]') : null;
            const kind = button?.dataset.random;
            if (kind !== 'projects' && kind !== 'blog') return;
            try {
                const paths = (await loadPaths())[kind];
                navigate(paths[Math.floor(Math.random() * paths.length)]);
            } catch (error) {
                console.error(error);
            }
        });
    </script>
</BaseLayout>
