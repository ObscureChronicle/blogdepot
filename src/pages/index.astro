---
import { getCollection } from 'astro:content';
import BiliBiliVideoPlayer from '../components/BiliBiliVideoPlayer.astro';
import Button from '../components/Button.astro';
import Hero from '../components/Hero.astro';
import PostPreview from '../components/PostPreview.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import siteConfig from '../data/site-config';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortItemsByDateDesc } from '../utils/data-utils';
import { sortPostsByTitlePinyin } from '../utils/sort-by-pinyin';

const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);

// projects 是百科条目，不讲究发布时间，按标题拼音排序而非日期
const projects = sortPostsByTitlePinyin(await getCollection('projects'));
const featuredProjects = projects.filter(({ data }) => data.isFeatured);
// 随机百科条目按钮的可选路径池
const projectPaths = projects.map(({ id }) => `/projects/${id}/`);
// 随机日志按钮的可选路径池
const postPaths = posts.map(({ id }) => `/blog/${id}/`);
---

<BaseLayout title="後漢・三国物語" description={siteConfig.description} image={siteConfig.image}>
    <Hero />
    <iframe src="https://store.steampowered.com/widget/2010900/" frameborder="0" class="w-full" height="190"></iframe><br /><br />
    {
        featuredProjects?.length > 0 && (
            <div class="mb-16 sm:mb-24">
                <h2 class="mb-4 text-xl font-serif italic sm:text-2xl">百科</h2>
                {featuredProjects.slice(0, 5).map((project) => (
                    <ProjectPreview project={project} class="mb-4 sm:mb-4" headingLevel="h3" />
                ))}
                <div class="mt-4 flex flex-wrap gap-2">
                    <Button href="/tags" target="_self">
                        所有百科条目
                    </Button>
                    <Button id="random-project-btn">随机百科条目</Button>
                </div>
            </div>
        )
    }
    {
        posts?.length > 0 && (
            <div class="mb-16 sm:mb-24">
                <h2 class="mb-4 text-xl font-serif italic sm:text-2xl">日志</h2>
                {posts.slice(0, 3).map((post) => (
                    <PostPreview post={post} class="mb-10 sm:mb-12" headingLevel="h3" />
                ))}
                <div class="mt-4 flex flex-wrap gap-2">
                    <Button href="/blog" target="_self">
                        所有日志
                    </Button>
                    <Button id="random-post-btn">随机日志</Button>
                </div>
            </div>
        )
    }
    <div>
        <h2 class="mb-4 text-xl font-serif italic sm:text-2xl">攻略+全流程视频</h2>
        <h3 class="mb-4 text-base font-serif sm:mb-4 sm:text-lg text-center">后汉篇</h3>
        <BiliBiliVideoPlayer aid="113916977877284" bvid="BV1nvFLeNEY6" cid="28504950572" page="1" />
        <h3 class="mb-4 text-base font-serif sm:mb-4 sm:text-lg text-center">三国篇</h3>
        <BiliBiliVideoPlayer bvid="BV1CZR9YNEw5" aid="114284650566825" cid="29247604058" />
        <h3 class="mb-4 text-base font-serif sm:mb-4 sm:text-lg text-center">星命诀</h3>
        <BiliBiliVideoPlayer bvid="BV1g7R7BTEd7" aid="116505232612070" cid="38040963285" />
    </div>
    <script is:inline define:vars={{ projectPaths, postPaths }}>
        function initRandomButtons() {
            document.getElementById('random-project-btn')?.addEventListener('click', () => {
                window.location.href = projectPaths[Math.floor(Math.random() * projectPaths.length)];
            });
            document.getElementById('random-post-btn')?.addEventListener('click', () => {
                window.location.href = postPaths[Math.floor(Math.random() * postPaths.length)];
            });
        }
        initRandomButtons();
        // 监听 document 级别的 astro:page-load，客户端导航回首页时重新绑定
        document.addEventListener('astro:page-load', initRandomButtons);
    </script>
</BaseLayout>
