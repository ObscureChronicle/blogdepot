---
import { type CollectionEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import PostPreview from '../../components/PostPreview.astro';
import { getSortedBlogPosts } from '../../utils/content-utils';
import { resolveTag } from '../../utils/data-utils';
import { withNeighbors } from '../../utils/neighbor-utils';
import WalineComments from '../../components/WalineComments.tsx';

export async function getStaticPaths() {
    // 按日期从旧到新排列：上一篇是更早发布的文章，下一篇是更新的文章
    const posts = (await getSortedBlogPosts()).reverse();
    return withNeighbors(posts).map(({ item, prev, next }) => ({
        params: { id: item.id },
        props: { post: item, prevPost: prev, nextPost: next }
    }));
}

type Props = { post: CollectionEntry<'blog'>; prevPost: CollectionEntry<'blog'> | null; nextPost: CollectionEntry<'blog'> | null };

const { post, prevPost, nextPost } = Astro.props;
const { title, publishDate, updatedDate, excerpt, tags = [], seo } = post.data;
const { Content } = await render(post);

const breadcrumb = {
    items: [
        { label: '首页', href: '/' },
        { label: '日志', href: '/blog' }
    ],
    current: title
};
---

<BaseLayout
    title={seo?.title ?? title}
    description={seo?.description ?? excerpt}
    image={seo?.image}
    pageType="article"
    showHeader={false}
    breadcrumb={breadcrumb}
    breadcrumbOwnTags={tags}
>
    <article class="mb-16 sm:mb-24">
        <header class="mb-8">
            <h1 class="text-3xl leading-tight font-serif font-medium sm:text-5xl sm:leading-tight">{title}</h1>
            <div class="mt-4 text-sm">
                <FormattedDate date={publishDate} />
                {
                    updatedDate && (
                        <>
                            {' '}
                            <span>
                                (Updated on <FormattedDate date={updatedDate} />)
                            </span>
                        </>
                    )
                }
            </div>
        </header>
        <div class="max-w-none prose sm:prose-lg font-serif text-justify indent-[2em]">
            <Content />
        </div>
        <div class="mt-8 flex flex-wrap items-center gap-6 text-sm justify-between sm:mt-12 sm:text-base">
            {
                tags.length > 0 && (
                    <div class="flex flex-wrap gap-x-5 gap-y-1 text-sm font-serif">
                        {tags.map(resolveTag).map((tag) => (
                            <a class="text-base text-[#131124] hover:underline bg-[#d8e3e7] px-[10px] py-[5px] mr-[10px]" href={`/tags/${tag.id}`}>
                                # {tag.name}
                            </a>
                        ))}
                    </div>
                )
            }
        </div>
    </article>
    {
        (prevPost || nextPost) && (
            <div class="my-16 sm:my-24">
                {prevPost && <h2 class="mb-10 text-xl font-serif italic sm:mb-10 sm:text-2xl">←上一篇</h2>}
                {prevPost && <PostPreview post={prevPost} class="mb-10 sm:mb-12" headingLevel="h3" />}
                {nextPost && <h2 class="mb-10 text-xl font-serif italic sm:mb-10 sm:text-2xl text-right">下一篇→</h2>}
                {nextPost && <PostPreview post={nextPost} class="mb-10 sm:mb-12" headingLevel="h3" />}
            </div>
        )
    }
<WalineComments client:load />
</BaseLayout>
