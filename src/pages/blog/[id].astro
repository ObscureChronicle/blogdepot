---
import { type CollectionEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import NoteCharacterCard from '../../components/NoteCharacterCard.astro';
import { getSortedBlogPosts } from '../../utils/content-utils';
import { resolveTag } from '../../utils/data-utils';
import { getBlogCategory } from '../../utils/blog-filter-utils';
import { splitBlogTitle } from '../../utils/blog-title';
import { withNeighbors } from '../../utils/neighbor-utils';
import WalineComments from '../../components/WalineComments.astro';

export async function getStaticPaths() {
    // 按日期从旧到新排列：上一篇是更早发布的文章，下一篇是更新的文章
    const posts = (await getSortedBlogPosts()).reverse();
    return withNeighbors(posts).map(({ item, prev, next }) => ({
        params: { id: item.id },
        props: { post: item, prevPost: prev, nextPost: next }
    }));
}

type Props = { post: CollectionEntry<'blog'>; prevPost: CollectionEntry<'blog'> | null; nextPost: CollectionEntry<'blog'> | null };

const { post, prevPost, nextPost } = Astro.props;
const { title, publishDate, updatedDate, excerpt, tags = [], seo, radar } = post.data;
const { Content } = await render(post);
const { eyebrow, main } = splitBlogTitle(title);
// 更新日志是版本条目 + 筛选工具栏，不是连续阅读的长文：保持整栏宽度，也不加结尾装饰符
const isReadingPost = getBlogCategory(post)?.id !== 'changelog';

const breadcrumb = {
    items: [
        { label: '首页', href: '/' },
        { label: '日志', href: '/blog/' }
    ],
    current: title
};

const neighbors = [
    prevPost && { label: '← 上一篇', post: prevPost, align: 'left' as const },
    nextPost && { label: '下一篇 →', post: nextPost, align: 'right' as const }
].filter((n) => n !== null);
---

<BaseLayout
    title={seo?.title ?? title}
    description={seo?.description ?? excerpt}
    image={seo?.image}
    pageType="article"
    showHeader={false}
    breadcrumb={breadcrumb}
    breadcrumbOwnTags={tags}
>
    <article class="mb-16 sm:mb-24">
        <header class="mb-8 font-serif sm:mb-10">
            {eyebrow && <p class="mb-2 text-sm tracking-widest opacity-70 sm:text-base">{eyebrow}</p>}
            <h1 class="text-3xl leading-tight font-medium sm:text-5xl sm:leading-tight">{main}</h1>
            <div class="mt-4 text-sm opacity-70">
                <FormattedDate date={publishDate} />
                {
                    updatedDate && (
                        <>
                            {' · '}
                            <span>
                                修订于 <FormattedDate date={updatedDate} />
                            </span>
                        </>
                    )
                }
            </div>
        </header>
        {radar && radar.length > 0 && <NoteCharacterCard radar={radar} class="mb-10 sm:mb-12" />}
        <div class:list={['prose sm:prose-lg font-serif text-justify indent-[2em]', isReadingPost ? 'mx-auto max-w-[38em]' : 'max-w-none']}>
            <Content />
            {isReadingPost && <p class="note-end" aria-hidden="true">◆</p>}
        </div>
        {
            tags.length > 0 && (
                <div class="mt-8 flex flex-wrap gap-3 font-serif sm:mt-12">
                    {tags.map(resolveTag).map((tag) => (
                        <a class="bg-muted px-3 py-1 text-sm transition hover:underline" href={`/tags/${tag.id}/`}>
                            # {tag.name}
                        </a>
                    ))}
                </div>
            )
        }
    </article>
    {
        neighbors.length > 0 && (
            <nav aria-label="上一篇与下一篇" class="my-16 grid gap-6 font-serif sm:my-24 sm:grid-cols-2">
                {neighbors.map(({ label, post: neighbor, align }) => {
                    const parts = splitBlogTitle(neighbor.data.title);
                    return (
                        <a
                            href={`/blog/${neighbor.id}/`}
                            class:list={['neighbor-link group flex flex-col gap-1 py-4', align === 'right' && 'sm:col-start-2 sm:text-right']}
                        >
                            <span class="text-sm opacity-70">{label}</span>
                            {parts.eyebrow && <span class="text-xs tracking-widest opacity-70">{parts.eyebrow}</span>}
                            <span class="text-lg leading-snug font-medium group-hover:underline group-hover:decoration-dashed group-hover:underline-offset-4 sm:text-xl">
                                {parts.main}
                            </span>
                        </a>
                    );
                })}
            </nav>
        )
    }
    <WalineComments />
</BaseLayout>

<style>
    /* 结尾装饰符：居中、不缩进，和正文拉开距离 */
    .note-end {
        margin-top: 2.5em;
        text-align: center;
        text-indent: 0;
        font-size: 0.75em;
        letter-spacing: 0;
        opacity: 0.5;
    }
    .neighbor-link {
        border-top: 1px solid color-mix(in srgb, var(--text-main) 14%, transparent);
    }
</style>
