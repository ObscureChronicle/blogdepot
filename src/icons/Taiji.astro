---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'svg'>;

const { class: className, ...props } = Astro.props;
---

{/* 太极：外圈描边，内部阴鱼填充当前文字色；阴鱼里的鱼眼用 evenodd 镂空，阳鱼里的鱼眼单独填充 */}
<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" class={className} {...props}>
    <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path fill-rule="evenodd" d="M12 2a10 10 0 0 1 0 20a5 5 0 0 1 0-10a5 5 0 0 0 0-10z M12 15.5a1.5 1.5 0 1 0 0 3a1.5 1.5 0 1 0 0-3z"></path>
    <circle cx="12" cy="7" r="1.5"></circle>
</svg>
