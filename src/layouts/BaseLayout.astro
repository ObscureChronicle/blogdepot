---
import { ClientRouter } from 'astro:transitions';
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Nav from '../components/Nav.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { thirdParty } from '../data/site-config';

export type Props = HeadProps & { showHeader?: boolean; breadcrumbOwnTags?: string[]; containerWidth?: 'default' | 'wide' };

const { showHeader = true, breadcrumb, breadcrumbOwnTags = [], containerWidth = 'default', ...head } = Astro.props;
---

<!doctype html>
<html lang="zh" class="antialiased break-words">
    <head>
        <BaseHead breadcrumb={breadcrumb} {...head} />
        <script>
            if (localStorage.theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        </script>
        <ClientRouter />
        <script is:inline src="/cursor-click.js" defer></script>
        <!-- Google tag (gtag.js) -->
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${thirdParty.ga4MeasurementId}`}></script>
        <script>
        import { thirdParty } from '../data/site-config';

        declare global {
            interface Window {
                dataLayer: unknown[];
            }
        }

        window.dataLayer = window.dataLayer || [];
        function gtag(..._args: unknown[]) {
            window.dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', thirdParty.ga4MeasurementId);
        </script>
    </head>
    <body class="bg-main text-main">
        <div class="flex flex-col min-h-screen px-4 md:px-8">
            <Nav />
            {breadcrumb && <Breadcrumb items={breadcrumb.items} current={breadcrumb.current} ownTags={breadcrumbOwnTags} class="mb-6" />}
            {showHeader && <Header />}
            <main class:list={['grow w-full mx-auto', containerWidth === 'wide' ? 'max-w-5xl' : 'max-w-3xl']}>
                <slot />
            </main>
            <ScrollToTop />
            <Footer />
        </div>
    </body>
</html>
