---
import { ClientRouter } from 'astro:transitions';
import BaseHead, { type Props as HeadProps } from '../components/BaseHead.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CursorClick from '../components/CursorClick.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Nav from '../components/Nav.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import { thirdParty } from '../data/site-config';

export type Props = HeadProps & { showHeader?: boolean; breadcrumbOwnTags?: string[] };

const { showHeader = true, breadcrumb, breadcrumbOwnTags = [], ...head } = Astro.props;
---

<!doctype html>
<html lang="zh" class="antialiased break-words">
    <head>
        <BaseHead breadcrumb={breadcrumb} {...head} />
        <script>
            if (localStorage.theme === 'dark') {
                document.documentElement.classList.add('dark');
            }
        </script>
        <script>
            // 竖向滚动条占用的宽度（触控板 / 手机上的悬浮滚动条为 0），供 global.css 的 .full-bleed 扣除
            const measureScrollbar = () =>
                document.documentElement.style.setProperty('--scrollbar-width', `${window.innerWidth - document.documentElement.clientWidth}px`);
            document.addEventListener('astro:page-load', measureScrollbar);
            window.addEventListener('resize', measureScrollbar, { passive: true });
        </script>
        <ClientRouter />
        <!-- Google tag (gtag.js) -->
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${thirdParty.ga4MeasurementId}`}></script>
        <script>
        import { thirdParty } from '../data/site-config';

        declare global {
            interface Window {
                dataLayer: unknown[];
            }
        }

        window.dataLayer = window.dataLayer || [];
        function gtag(..._args: unknown[]) {
            window.dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', thirdParty.ga4MeasurementId);
        </script>
    </head>
    <body class="bg-main text-main">
        <div class="flex flex-col min-h-screen px-4 md:px-8">
            <Nav />
            {breadcrumb && <Breadcrumb items={breadcrumb.items} current={breadcrumb.current} ownTags={breadcrumbOwnTags} class="mb-6" />}
            {showHeader && <Header />}
            <main class="grow w-full max-w-3xl mx-auto">
                <slot />
            </main>
            <ScrollToTop />
            <Footer />
        </div>
        <CursorClick />
    </body>
</html>
