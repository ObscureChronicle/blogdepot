---
import BarChart from '../components/BarChart.jsx';
import RadarChart from '../components/RadarChart';
import StageStringTable from '../components/Table_Stages.jsx';
import FiveStringTable from '../components/Table_Traits.jsx';
import CharacterNameTable from './Table_CharacterName.jsx';
import CharacterAbilitySection from './CharacterAbilitySection.jsx';
import { EDITIONS } from '../data/editions';
import { getWikiLink } from '../utils/wiki-links';

type CharacterWikiProps = {
    intro: string;
    baseData: number[];
    postData?: number[];
    prevDataName?: string;
    postDataName?: string;
    AttributeFigure: number[];
    dlcData: number[];
    dlcAttributeFigure: number[];
    baseData2: number[];
    dlcData2: number[];
    traitsBase: string[];
    traitsDLC: string[];
    biography: string;
    baseclass: string[];
    dlcclass: string[];
    battlesBase: [string, string][];
    battlesDLC: [string, string][];
    equipments: string[];
    links: { label: string; href: string }[];
    nameTableData: {};
    postBaseData2?: number[];
    traitsPost?: string[];
    /**
     * 能力区的两种渲染方式（经 BiographyLayout2.astro 导入的词条为 true）：
     * - false：雷达图、柱状图、特质表分别渲染，后期形态按钮由雷达图自带，只切换雷达图
     * - true：交给 CharacterAbilitySection，后期形态按钮同时切换雷达图、柱状图和特质表
     */
    combinedAbility?: boolean;
};

const {
    intro,
    baseData,
    AttributeFigure,
    dlcData,
    dlcAttributeFigure,
    baseData2,
    dlcData2,
    traitsBase,
    traitsDLC,
    biography,
    baseclass,
    dlcclass,
    battlesBase,
    battlesDLC,
    equipments,
    links,
    postData,
    prevDataName,
    postDataName,
    nameTableData,
    postBaseData2,
    traitsPost,
    combinedAbility = false
} = Astro.props as CharacterWikiProps;

const basename = EDITIONS.base.name;
const dlcname = EDITIONS.dlc.name;
const basename_short = EDITIONS.base.shortName;
const dlcname_short = EDITIONS.dlc.shortName;

const getClassLink = (name: string) => {
    return getWikiLink('class', name);
};
---
{
    !baseData && !dlcData ? <><div>背景人物。</div>
        <h2  class='section-title'>剧中别称</h2>
        <CharacterNameTable data={nameTableData ? nameTableData : {}} /></>: (
        <p>
            登场于{baseData && basename}{baseData && dlcData && '与'}{dlcData && dlcname}的{intro}角色。
        </p>
        <h2  class='section-title'>剧中别称</h2>
        <CharacterNameTable data={nameTableData ? nameTableData : {}} />
        <h2  class='section-title'>能力</h2>
        <div class="flex justify-evenly sm:flex-row flex-col">
            {
                combinedAbility ? (
                    baseData && (
                        <div class="flex flex-col items-center">
                            <CharacterAbilitySection
                                client:load
                                baseData={baseData}
                                postData={postData}
                                prevDataName={prevDataName}
                                postDataName={postDataName}
                                attributefigure={AttributeFigure}
                                baseData2={baseData2}
                                basename_short={basename_short}
                                postBaseData2={postBaseData2}
                                traitsBase={traitsBase}
                                traitsPost={traitsPost}
                                dlcData={dlcData}
                                dlcData2={dlcData2}
                                dlcAttributeFigure={dlcAttributeFigure}
                                dlcname_short={dlcname_short}
                                traitsDLC={traitsDLC}
                            />
                        </div>
                    )
                ) : (
                    <>
                        {baseData && (
                            <div class="flex flex-col items-center">
                                <span class="bg-blue-100 text-blue-800 text-base font-medium px-1.5 pt-1 rounded-sm dark:bg-blue-900 dark:text-blue-300">{basename_short}</span>
                                <RadarChart client:load data={baseData} postdata={postData} prevDataName={prevDataName} postDataName={postDataName} attributefigure={AttributeFigure} />
                                <BarChart client:load data={baseData2} />
                                <FiveStringTable data={traitsBase} />
                            </div>
                        )}
                        {dlcData && (
                            <div class="flex flex-col items-center">
                                <span class="bg-yellow-100 text-yellow-800 text-base font-medium px-1.5 pt-1 rounded-sm dark:bg-yellow-900 dark:text-yellow-300">
                                    {dlcname_short}
                                </span>
                                <RadarChart client:load variant="dlc" data={dlcData} attributefigure={dlcAttributeFigure} />
                                <BarChart client:load data={dlcData2} />
                                <FiveStringTable data={traitsDLC} />
                            </div>
                        )}
                    </>
                )
            }
        </div>
    )
}

{
    biography && (
        <>
            <h2  class='section-title'>列传</h2>
            <p class="whitespace-pre-line text-base leading-relaxed">{biography}</p>
        </>
    )
}
{
    !baseclass && !dlcclass ? null : (
        <>
            <h2  class='section-title'>默认兵种</h2>
            {baseclass && (
                <div>
                    <p class="inline-block bg-blue-100 text-blue-800 text-base font-medium px-1.5 pt-1 rounded-sm dark:bg-blue-900 dark:text-blue-300">
                        {basename_short}
                    </p>
                    <p class="whitespace-pre-line text-base leading-relaxed">{baseclass && baseclass.map((e) => getClassLink(e) ? <a href={getClassLink(e) || ''} class="block text-blue-600 hover:text-blue-800 hover:underline">{e}</a> : <span class="block">{e}</span>)}</p>
                </div>
            )}
            {dlcclass && (
                <div>
                    <p class="inline-block bg-yellow-100 text-yellow-800 text-base font-medium px-1.5 pt-1 rounded-sm dark:bg-yellow-900 dark:text-yellow-300">
                        {dlcname_short}
                    </p>
                    <p class="whitespace-pre-line text-base leading-relaxed">{dlcclass && dlcclass.map((e) => getClassLink(e) ? <a href={getClassLink(e) || ''} class="block text-blue-600 hover:text-blue-800 hover:underline">{e}</a> : <span class="block">{e}</span>)}</p>
                </div>
            )}
        </>
    )
}
{
    !battlesBase && !battlesDLC ? null : (
        <>
            <h2  class='section-title'>登场战役</h2>
            <div class="flex flex-col pl-4 gap-4">
                {battlesBase && (
                    <div class="flex flex-col items-center">
                        <span class="bg-blue-100 text-blue-800 text-base font-medium px-1.5 pt-1 rounded-sm dark:bg-blue-900 dark:text-blue-300">
                            {basename_short}
                        </span>
                        <StageStringTable data={battlesBase} />
                    </div>
                )}
                {battlesDLC && (
                    <div class="flex flex-col items-center">
                        <span class="bg-yellow-100 text-yellow-800 text-base font-medium px-1.5 pt-1 rounded-sm dark:bg-yellow-900 dark:text-yellow-300">
                            {dlcname_short}
                        </span>
                        <StageStringTable data={battlesDLC} variant="dlc" />
                    </div>
                )}
            </div>
        </>
    )
}
{
    equipments && equipments.length > 0 ? (
        <>
            <h2  class='section-title'>关联装备</h2>
            <div class="flex flex-col pl-4">{equipments.map((e) => { const href = getWikiLink('item', e); return href ? <a href={href}>{e}</a> : <span>{e}</span>; })}</div>
        </>
    ) : null
}
{
    links && (
        <h2  class='section-title'>更多</h2>
        <div class="flex flex-col pl-4">
            {
                links.map((l) => (
                    <a href={l.href} target="_blank">
                        {l.label}
                    </a>
                ))
            }
        </div>
    )
}
