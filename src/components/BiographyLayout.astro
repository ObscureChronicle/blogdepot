---
import BarChart from '../components/BarChart.jsx';
import RadarChart from '../components/RadarChart';
import StageStringTable from '../components/Table_Stages.jsx';
import FiveStringTable from '../components/Table_Traits.jsx';
import CharacterNameTable from './Table_CharacterName.jsx';
import CharacterAbilitySection from './CharacterAbilitySection.jsx';
import EditionBadge from './EditionBadge.astro';
import SectionTitle from './SectionTitle.astro';
import { EDITIONS } from '../data/editions';
import WikiLink from './WikiLink.astro';

type CharacterWikiProps = {
    intro: string;
    baseData: number[];
    postData?: number[];
    prevDataName?: string;
    postDataName?: string;
    AttributeFigure: number[];
    dlcData: number[];
    dlcAttributeFigure: number[];
    baseData2: number[];
    dlcData2: number[];
    traitsBase: string[];
    traitsDLC: string[];
    biography: string;
    baseclass: string[];
    dlcclass: string[];
    battlesBase: [string, string][];
    battlesDLC: [string, string][];
    equipments: string[];
    links: { label: string; href: string }[];
    nameTableData: {};
    postBaseData2?: number[];
    traitsPost?: string[];
    /**
     * 能力区的两种渲染方式（经 BiographyLayout2.astro 导入的词条为 true）：
     * - false：雷达图、柱状图、特质表分别渲染，后期形态按钮由雷达图自带，只切换雷达图
     * - true：交给 CharacterAbilitySection，后期形态按钮同时切换雷达图、柱状图和特质表
     */
    combinedAbility?: boolean;
};

const {
    intro,
    baseData,
    AttributeFigure,
    dlcData,
    dlcAttributeFigure,
    baseData2,
    dlcData2,
    traitsBase,
    traitsDLC,
    biography,
    baseclass,
    dlcclass,
    battlesBase,
    battlesDLC,
    equipments,
    links,
    postData,
    prevDataName,
    postDataName,
    nameTableData,
    postBaseData2,
    traitsPost,
    combinedAbility = false
} = Astro.props as CharacterWikiProps;

const basename = EDITIONS.base.name;
const dlcname = EDITIONS.dlc.name;
const basename_short = EDITIONS.base.shortName;
const dlcname_short = EDITIONS.dlc.shortName;
---
{
    !baseData && !dlcData ? <><div>背景人物。</div>
        <SectionTitle>剧中别称</SectionTitle>
        <CharacterNameTable data={nameTableData ? nameTableData : {}} /></>: (
        <p>
            登场于{baseData && basename}{baseData && dlcData && '与'}{dlcData && dlcname}的{intro}角色。
        </p>
        <SectionTitle>剧中别称</SectionTitle>
        <CharacterNameTable data={nameTableData ? nameTableData : {}} />
        <SectionTitle>能力</SectionTitle>
        <div class="flex justify-evenly sm:flex-row flex-col">
            {
                combinedAbility ? (
                    baseData && (
                        <div class="flex flex-col items-center">
                            <CharacterAbilitySection
                                client:load
                                baseData={baseData}
                                postData={postData}
                                prevDataName={prevDataName}
                                postDataName={postDataName}
                                attributefigure={AttributeFigure}
                                baseData2={baseData2}
                                basename_short={basename_short}
                                postBaseData2={postBaseData2}
                                traitsBase={traitsBase}
                                traitsPost={traitsPost}
                                dlcData={dlcData}
                                dlcData2={dlcData2}
                                dlcAttributeFigure={dlcAttributeFigure}
                                dlcname_short={dlcname_short}
                                traitsDLC={traitsDLC}
                            />
                        </div>
                    )
                ) : (
                    <>
                        {baseData && (
                            <div class="flex flex-col items-center">
                                <EditionBadge edition="base" />
                                <RadarChart client:load data={baseData} postdata={postData} prevDataName={prevDataName} postDataName={postDataName} attributefigure={AttributeFigure} />
                                <BarChart client:load data={baseData2} />
                                <FiveStringTable data={traitsBase} />
                            </div>
                        )}
                        {dlcData && (
                            <div class="flex flex-col items-center">
                                <EditionBadge edition="dlc" />
                                <RadarChart client:load variant="dlc" data={dlcData} attributefigure={dlcAttributeFigure} />
                                <BarChart client:load data={dlcData2} />
                                <FiveStringTable data={traitsDLC} />
                            </div>
                        )}
                    </>
                )
            }
        </div>
    )
}

{
    biography && (
        <>
            <SectionTitle>列传</SectionTitle>
            <p class="whitespace-pre-line text-base leading-relaxed">{biography}</p>
        </>
    )
}
{
    !baseclass && !dlcclass ? null : (
        <>
            <SectionTitle>默认兵种</SectionTitle>
            {baseclass && (
                <div>
                    <EditionBadge edition="base" tag="p" />
                    <p class="whitespace-pre-line text-base leading-relaxed">{baseclass.map((e) => <WikiLink kind="class" name={e} class="block" />)}</p>
                </div>
            )}
            {dlcclass && (
                <div>
                    <EditionBadge edition="dlc" tag="p" />
                    <p class="whitespace-pre-line text-base leading-relaxed">{dlcclass.map((e) => <WikiLink kind="class" name={e} class="block" />)}</p>
                </div>
            )}
        </>
    )
}
{
    !battlesBase && !battlesDLC ? null : (
        <>
            <SectionTitle>登场战役</SectionTitle>
            <div class="flex flex-col pl-4 gap-4">
                {battlesBase && (
                    <div class="flex flex-col items-center">
                        <EditionBadge edition="base" />
                        <StageStringTable data={battlesBase} />
                    </div>
                )}
                {battlesDLC && (
                    <div class="flex flex-col items-center">
                        <EditionBadge edition="dlc" />
                        <StageStringTable data={battlesDLC} variant="dlc" />
                    </div>
                )}
            </div>
        </>
    )
}
{
    equipments && equipments.length > 0 ? (
        <>
            <SectionTitle>关联装备</SectionTitle>
            <div class="flex flex-col pl-4">{equipments.map((e) => <WikiLink kind="item" name={e} linkClass="" />)}</div>
        </>
    ) : null
}
{
    links && (
        <SectionTitle>更多</SectionTitle>
        <div class="flex flex-col pl-4">
            {
                links.map((l) => (
                    <a href={l.href} target="_blank">
                        {l.label}
                    </a>
                ))
            }
        </div>
    )
}
