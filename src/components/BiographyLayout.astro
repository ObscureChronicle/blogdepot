---
import StageStringTable from '../components/Table_Stages.jsx';
import CharacterNameTable from './Table_CharacterName.jsx';
import CharacterAbilitySection from './CharacterAbilitySection.jsx';
import EditionBadge from './EditionBadge.astro';
import SectionTitle from './SectionTitle.astro';
import { EDITIONS, type Edition } from '../data/editions';
import { TRAIT_LEVELS } from '../utils/trait-levels';
import WikiLink from './WikiLink.astro';

/** 本传的一个形态；多个形态时 name 是切换按钮文字 */
type BaseForm = {
    name?: string;
    /** [统御, 气运, 武勇, 智略, 魅力] */
    data: number[];
    /** [胆识, 冷静] */
    data2: number[];
    traits: string[];
    /** 各属性的上限加成，顺序同 data；省略则雷达图不显示上限标记 */
    figure?: number[];
};

/** 初始设定表格的一行 */
type InitialSetupRow = {
    label: string;
    value: string;
};

/** 初始设定按版本分组的表格内容 */
type InitialSetupGroup = {
    edition: Edition;
    rows: InitialSetupRow[];
};

/** 军略：军略名与习得时机 */
type ArtOfWarEntry = {
    name: string;
    learnedAt: string;
};

type CharacterWikiProps = {
    intro: string;
    /** 本传各形态，按游戏内出现顺序；没有本传数据时省略 */
    baseForms?: BaseForm[];
    dlcData: number[];
    dlcAttributeFigure: number[];
    dlcData2: number[];
    traitsDLC: string[];
    biography: string;
    baseclass: string[];
    dlcclass: string[];
    battlesBase: [string, string][];
    battlesDLC: [string, string][];
    equipments: string[];
    links: { label: string; href: string }[];
    nameTableData: {};
    /** 初始设定：按版本分组的表格 */
    initialSetup?: InitialSetupGroup[];
    /** 初始设定表格下方的脚注 */
    initialSetupNote?: string;
    /** 入队装备，与「关联装备」一样按物品名生成词条链接 */
    initialEquipments?: string[];
    /** 军略：军略名 + 习得时机 */
    artsOfWar?: ArtOfWarEntry[];
    /** 因缘：其他人物名称，按人物名生成词条链接 */
    bonds?: string[];
};

const {
    intro,
    baseForms,
    dlcData,
    dlcAttributeFigure,
    dlcData2,
    traitsDLC,
    biography,
    baseclass,
    dlcclass,
    battlesBase,
    battlesDLC,
    equipments,
    links,
    nameTableData,
    initialSetup,
    initialSetupNote,
    initialEquipments,
    artsOfWar,
    bonds
} = Astro.props as CharacterWikiProps;

const hasBase = (baseForms?.length ?? 0) > 0;

const basename = EDITIONS.base.name;
const dlcname = EDITIONS.dlc.name;
const basename_short = EDITIONS.base.shortName;
const dlcname_short = EDITIONS.dlc.shortName;
---
{
    !hasBase && !dlcData ? <><div>背景人物。</div>
        <SectionTitle>剧中别称</SectionTitle>
        <CharacterNameTable data={nameTableData ? nameTableData : {}} /></>: (
        <p>
            登场于{hasBase && basename}{hasBase && dlcData && '与'}{dlcData && dlcname}的{intro}角色。
        </p>
        <SectionTitle>剧中别称</SectionTitle>
        <CharacterNameTable data={nameTableData ? nameTableData : {}} />
        <SectionTitle>能力</SectionTitle>
        <CharacterAbilitySection
            client:load
            baseForms={baseForms}
            basename_short={basename_short}
            dlcData={dlcData}
            dlcData2={dlcData2}
            dlcAttributeFigure={dlcAttributeFigure}
            dlcname_short={dlcname_short}
            traitsDLC={traitsDLC}
            traitLevels={TRAIT_LEVELS}
        />
    )
}

{
    biography && (
        <>
            <SectionTitle>列传</SectionTitle>
            <p class="whitespace-pre-line text-base leading-relaxed" set:html={biography} />
        </>
    )
}
{
    !baseclass && !dlcclass ? null : (
        <>
            <SectionTitle>默认兵种</SectionTitle>
            {baseclass && (
                <div>
                    <EditionBadge edition="base" tag="p" />
                    <p class="whitespace-pre-line text-base leading-relaxed">{baseclass.map((e) => <WikiLink kind="class" name={e} class="block" />)}</p>
                </div>
            )}
            {dlcclass && (
                <div>
                    <EditionBadge edition="dlc" tag="p" />
                    <p class="whitespace-pre-line text-base leading-relaxed">{dlcclass.map((e) => <WikiLink kind="class" name={e} class="block" />)}</p>
                </div>
            )}
        </>
    )
}
{
    !battlesBase && !battlesDLC ? null : (
        <>
            <SectionTitle>登场战役</SectionTitle>
            <div class="flex flex-col pl-4 gap-4">
                {battlesBase && (
                    <div class="flex flex-col items-center">
                        <EditionBadge edition="base" />
                        <StageStringTable data={battlesBase} />
                    </div>
                )}
                {battlesDLC && (
                    <div class="flex flex-col items-center">
                        <EditionBadge edition="dlc" />
                        <StageStringTable data={battlesDLC} variant="dlc" />
                    </div>
                )}
            </div>
        </>
    )
}
{
    initialSetup && initialSetup.length > 0 ? (
        <>
            <SectionTitle>初始设定</SectionTitle>
            <table class="wiki-table wiki-table--hover not-prose mt-2 max-w-[30rem]">
                <tbody>
                    {initialSetup.map((group) => (
                        <>
                            <tr>
                                <th scope="rowgroup" colspan="2">
                                    {EDITIONS[group.edition].shortName}
                                </th>
                            </tr>
                            {group.rows.map((row) => (
                                <tr>
                                    <th scope="row" class="w-28">
                                        {row.label}
                                    </th>
                                    <td class="text-right">{row.value}</td>
                                </tr>
                            ))}
                        </>
                    ))}
                </tbody>
            </table>
            {initialSetupNote && <p class="text-base leading-relaxed">{initialSetupNote}</p>}
        </>
    ) : null
}
{
    initialEquipments && initialEquipments.length > 0 ? (
        <>
            <SectionTitle>入队装备</SectionTitle>
            <div class="flex flex-col pl-4">{initialEquipments.map((e) => <WikiLink kind="item" name={e} linkClass="" />)}</div>
        </>
    ) : null
}
{
    artsOfWar && artsOfWar.length > 0 ? (
        <>
            <SectionTitle>军略</SectionTitle>
            <table class="wiki-table wiki-table--hover not-prose mt-2 max-w-[30rem]">
                <thead>
                    <tr>
                        <th scope="col">军略名</th>
                        <th scope="col">习得时机</th>
                    </tr>
                </thead>
                <tbody>
                    {artsOfWar.map((entry) => (
                        <tr>
                            <th scope="row">{entry.name}</th>
                            <td class="text-right">{entry.learnedAt}</td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </>
    ) : null
}
{
    bonds && bonds.length > 0 ? (
        <>
            <SectionTitle>因缘</SectionTitle>
            <div class="flex flex-col pl-4">{bonds.map((name) => <WikiLink kind="character" name={name} />)}</div>
        </>
    ) : null
}
{
    equipments && equipments.length > 0 ? (
        <>
            <SectionTitle>关联装备</SectionTitle>
            <div class="flex flex-col pl-4">{equipments.map((e) => <WikiLink kind="item" name={e} linkClass="" />)}</div>
        </>
    ) : null
}
{
    links && (
        <SectionTitle>更多</SectionTitle>
        <div class="flex flex-col pl-4">
            {
                links.map((l) => (
                    <a href={l.href} target="_blank">
                        {l.label}
                    </a>
                ))
            }
        </div>
    )
}
