---
type Props = {
    effect: string;
    dlcEffect?: string;
};

import EditionSplit from './EditionSplit.astro';

const { effect, dlcEffect } = Astro.props as Props;
---

{
    (effect || dlcEffect) && (
        <>
            <h2 class="bg-blue-100 text-blue-800 text-2xl font-bold px-2.5 pt-1.5 rounded-sm dark:bg-blue-200 dark:text-blue-800 inline-block">效果</h2>
            {/* 存在 dlcEffect 时，本传与星命诀分别显示小标签；否则不显示小标签 */}
            <EditionSplit showBase={!!effect} showDlc={!!dlcEffect}>
                <p slot="base" class="whitespace-pre-line text-base leading-relaxed">{effect}</p>
                <p slot="dlc" class="whitespace-pre-line text-base leading-relaxed">{dlcEffect}</p>
            </EditionSplit>
        </>
    )
}
