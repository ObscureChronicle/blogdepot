---
type EquipmentData = {
    base?: Record<string, string | number>;
    damageBonus?: Record<string, number>;
    damageReduction?: Record<string, number>;
};

type EquipmentWikiProps = {
    baseDescription?: string;
    dlcDescription?: string;
    baseEquipment?: EquipmentData;
    dlcEquipment?: EquipmentData;
    noteHtml?: string;
};

const { baseDescription, dlcDescription, baseEquipment, dlcEquipment, noteHtml } = Astro.props as EquipmentWikiProps;

import EquipmentStats from './EquipmentStats.jsx';
import TraitNote from './TraitNote.astro';

const h2Class = 'bg-blue-100 text-blue-800 text-2xl font-bold px-2.5 pt-1.5 rounded-sm dark:bg-blue-200 dark:text-blue-800 inline-block';
const baseTagClass = 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300 text-base font-bold px-2 py-0.5 rounded-sm inline-block';
const dlcTagClass = 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300 text-base font-bold px-2 py-0.5 rounded-sm inline-block';

const hasEquipment = (e?: EquipmentData) => !!e && Object.values(e).some((v) => !!v && Object.keys(v).length > 0);

const showBaseDesc = !!baseDescription && baseDescription.length > 0;
const showDlcDesc = !!dlcDescription && dlcDescription.length > 0;
const showBaseEquip = hasEquipment(baseEquipment);
const showDlcEquip = hasEquipment(dlcEquipment);
---

{/* ==================== 说明 ==================== */}
{
    (showBaseDesc || showDlcDesc) && (
        <>
            <h2 class={h2Class}>说明</h2>
            {showDlcDesc ? (
                <>
                    {showBaseDesc && (
                        <div>
                            <span class={baseTagClass}>本传</span>
                            <p class="whitespace-pre-line text-base leading-relaxed">{baseDescription}</p>
                        </div>
                    )}
                    <div>
                        <span class={dlcTagClass}>星命诀</span>
                        <p class="whitespace-pre-line text-base leading-relaxed">{dlcDescription}</p>
                    </div>
                </>
            ) : (
                <p class="whitespace-pre-line text-base leading-relaxed">{baseDescription}</p>
            )}
        </>
    )
}

{/* ==================== 效果 ==================== */}
{
    (showBaseEquip || showDlcEquip) && (
        <>
            <h2 class={h2Class}>效果</h2>
            {showDlcEquip ? (
                <>
                    {showBaseEquip && (
                        <div>
                            <span class={baseTagClass}>本传</span>
                            <EquipmentStats equipment={baseEquipment} />
                        </div>
                    )}
                    <div>
                        <span class={dlcTagClass}>星命诀</span>
                        <EquipmentStats equipment={dlcEquipment} />
                    </div>
                </>
            ) : (
                <EquipmentStats equipment={baseEquipment} />
            )}
        </>
    )
}

<TraitNote noteHtml={noteHtml} />
