---
type EquipmentData = {
    /** 基础属性组；效果 可传入字符串（单条）或数组（多条） */
    base?: Record<string, string | number | string[]>;
    damageBonus?: Record<string, number>;
    damageReduction?: Record<string, number>;
};

/**
 * 同名宝物的一首附诗及其对应的效果（如青釭的三首诗）。多首时在「说明」上方显示「其一 / 其二」切换按钮，
 * 说明、效果、正主、素材一起切换。owner / materials 省略时沿用顶层的 baseOwner / baseMaterials（dlc 同理）。
 */
type PoemLocalization = { hant?: string; ja?: string; en?: string };

type TreasureVariant = {
    /** 切换按钮文字，省略时按顺序为「其一」「其二」… */
    label?: string;
    description: string;
    /** 这首附诗的本地化文本；只在配饰附诗总览表里使用，本组件不渲染 */
    localization?: PoemLocalization;
    equipment: EquipmentData;
    owner?: string[];
    materials?: string[];
};

type EquipmentWikiProps = {
    baseDescription?: string;
    dlcDescription?: string;
    baseEquipment?: EquipmentData;
    dlcEquipment?: EquipmentData;
    /** 有多首附诗时代替 baseDescription / baseEquipment，两种写法不要混用 */
    baseVariants?: TreasureVariant[];
    dlcVariants?: TreasureVariant[];
    baseOwner?: string[];
    dlcOwner?: string[];
    baseMaterials?: string[];
    dlcMaterials?: string[];
    /** 单首附诗的本地化文本；只在配饰附诗总览表里使用，本组件不渲染 */
    baseLocalization?: PoemLocalization;
    dlcLocalization?: PoemLocalization;
    noteHtml?: string;
};

const {
    baseDescription,
    dlcDescription,
    baseEquipment,
    dlcEquipment,
    baseVariants,
    dlcVariants,
    baseOwner = [],
    dlcOwner = [],
    baseMaterials = [],
    dlcMaterials = [],
    noteHtml
} = Astro.props as EquipmentWikiProps;

import EditionSplit from './EditionSplit.astro';
import SectionTitle from './SectionTitle.astro';
import EquipmentStats from './EquipmentStats.jsx';
import TraitNote from './TraitNote.astro';
import WikiLink from './WikiLink.astro';
import VariantToggle from './VariantToggle.astro';
import { STATUS_MAP } from '../utils/wiki-links';
import { linkStatusNames, linkStatusTokens, type StatusTextPart } from '../utils/status-link-parts';

// 「免疫」「效果」里的状态名 → 状态词条；免疫中的非状态名（如「所有不良状态」）回退到状态总览
const STATUS_OVERVIEW = '/projects/status/00_status/';
const STATUS_NAMES = Object.keys(STATUS_MAP).sort((a, b) => b.length - a.length);
const statusHref = (name: string) => STATUS_MAP[name] ?? null;

const buildLinkedValues = (equipment?: EquipmentData): Record<string, StatusTextPart[]> => {
    const result: Record<string, StatusTextPart[]> = {};
    if (!equipment) return result;

    for (const group of Object.values(equipment)) {
        if (!group || typeof group !== 'object') continue;
        for (const [key, value] of Object.entries(group)) {
            if (typeof value === 'number') continue;
            if (key === '免疫' && typeof value === 'string' && !result[value]) {
                result[value] = linkStatusTokens(value, statusHref, STATUS_OVERVIEW);
            } else if (key === '效果') {
                const items = Array.isArray(value) ? value : value ? [value] : [];
                for (const item of items) {
                    if (typeof item === 'string' && !result[item]) {
                        result[item] = linkStatusNames(item, STATUS_NAMES, statusHref);
                    }
                }
            }
        }
    }
    return result;
};

const CHINESE_NUMERALS = ['一', '二', '三', '四', '五', '六', '七', '八', '九', '十'];
const defaultLabel = (i: number) => `其${CHINESE_NUMERALS[i] ?? i + 1}`;

type ResolvedVariant = {
    label: string;
    description: string;
    equipment?: EquipmentData;
    linkedValues: Record<string, StatusTextPart[]>;
    owner: string[];
    materials: string[];
};

// 单首附诗的旧写法也统一成只有一个元素的数组，渲染时不用分两套
const resolveVariants = (
    variants: TreasureVariant[] | undefined,
    description: string | undefined,
    equipment: EquipmentData | undefined,
    owner: string[],
    materials: string[]
): ResolvedVariant[] => {
    const list = variants && variants.length > 0 ? variants : [{ description: description ?? '', equipment, owner, materials }];
    return list.map((v, i) => ({
        label: ('label' in v && v.label) || defaultLabel(i),
        description: v.description,
        equipment: v.equipment,
        linkedValues: buildLinkedValues(v.equipment),
        owner: v.owner ?? owner,
        materials: v.materials ?? materials
    }));
};

const base = resolveVariants(baseVariants, baseDescription, baseEquipment, baseOwner, baseMaterials);
const dlc = resolveVariants(dlcVariants, dlcDescription, dlcEquipment, dlcOwner, dlcMaterials);
const editions = { base, dlc } as const;
type Edition = keyof typeof editions;

const hasEquipment = (e?: EquipmentData) => !!e && Object.values(e).some((v) => !!v && Object.keys(v).length > 0);
const some = (list: ResolvedVariant[], pick: (v: ResolvedVariant) => boolean) => list.some(pick);

const showBaseDesc = some(base, (v) => v.description.length > 0);
const showDlcDesc = some(dlc, (v) => v.description.length > 0);
const showBaseEquip = some(base, (v) => hasEquipment(v.equipment));
const showDlcEquip = some(dlc, (v) => hasEquipment(v.equipment));
const showBaseOwner = some(base, (v) => v.owner.length > 0);
const showDlcOwner = some(dlc, (v) => v.owner.length > 0);
const showBaseMaterials = some(base, (v) => v.materials.length > 0);
const showDlcMaterials = some(dlc, (v) => v.materials.length > 0);

// 多首附诗时每个内容块带上分组属性，非首个默认隐藏；只有一首时不加属性，输出与原来一致
const variantAttrs = (edition: Edition, i: number) =>
    editions[edition].length > 1 ? { 'data-variant-group': `treasure-${edition}`, 'data-variant-index': String(i), hidden: i > 0 } : {};
---

{/* ==================== 说明 ==================== */}
{
    (showBaseDesc || showDlcDesc) && (
        <>
            <SectionTitle>说明</SectionTitle>
            <EditionSplit showBase={showBaseDesc} showDlc={showDlcDesc}>
                {(['base', 'dlc'] as const).map((edition) => (
                    <Fragment slot={edition}>
                        {editions[edition].length > 1 && <VariantToggle group={`treasure-${edition}`} labels={editions[edition].map((v) => v.label)} />}
                        {editions[edition].map((v, i) => (
                            <p class="whitespace-pre-line text-base leading-relaxed" {...variantAttrs(edition, i)}>
                                {v.description}
                            </p>
                        ))}
                    </Fragment>
                ))}
            </EditionSplit>
        </>
    )
}

{/* ==================== 效果 ==================== */}
{
    (showBaseEquip || showDlcEquip) && (
        <>
            <SectionTitle>效果</SectionTitle>
            <EditionSplit showBase={showBaseEquip} showDlc={showDlcEquip}>
                {(['base', 'dlc'] as const).map((edition) => (
                    <Fragment slot={edition}>
                        {editions[edition].map((v, i) =>
                            editions[edition].length > 1 ? (
                                <div {...variantAttrs(edition, i)}>
                                    {hasEquipment(v.equipment) && <EquipmentStats equipment={v.equipment} linkedValues={v.linkedValues} />}
                                </div>
                            ) : (
                                hasEquipment(v.equipment) && <EquipmentStats equipment={v.equipment} linkedValues={v.linkedValues} />
                            )
                        )}
                    </Fragment>
                ))}
            </EditionSplit>
        </>
    )
}

{/* ==================== 正主 ==================== */}
{
    (showBaseOwner || showDlcOwner) && (
        <>
            <SectionTitle>正主</SectionTitle>
            <EditionSplit showBase={showBaseOwner} showDlc={showDlcOwner}>
                {(['base', 'dlc'] as const).map((edition) => (
                    <Fragment slot={edition}>
                        {editions[edition].map((v, i) => (
                            <div class="flex flex-col items-start gap-1" {...variantAttrs(edition, i)}>
                                {v.owner.map((name) => (
                                    <WikiLink kind="character" name={name} />
                                ))}
                            </div>
                        ))}
                    </Fragment>
                ))}
            </EditionSplit>
        </>
    )
}

{/* ==================== 素材 ==================== */}
{
    (showBaseMaterials || showDlcMaterials) && (
        <>
            <SectionTitle>素材</SectionTitle>
            <EditionSplit showBase={showBaseMaterials} showDlc={showDlcMaterials}>
                {(['base', 'dlc'] as const).map((edition) => (
                    <Fragment slot={edition}>
                        {editions[edition].map((v, i) => (
                            <table class="wiki-table wiki-table--list not-prose mt-2 max-w-[20rem]" {...variantAttrs(edition, i)}>
                                <tbody>
                                    {v.materials.map((item) => (
                                        <tr>
                                            <td>
                                                <WikiLink kind="item" name={item} bare />
                                            </td>
                                        </tr>
                                    ))}
                                </tbody>
                            </table>
                        ))}
                    </Fragment>
                ))}
            </EditionSplit>
        </>
    )
}

<TraitNote noteHtml={noteHtml} />
