---
type EquipmentData = {
    base?: Record<string, string | number>;
    damageBonus?: Record<string, number>;
    damageReduction?: Record<string, number>;
};

type EquipmentWikiProps = {
    baseDescription?: string;
    dlcDescription?: string;
    baseEquipment?: EquipmentData;
    dlcEquipment?: EquipmentData;
    baseOwner?: string[];
    dlcOwner?: string[];
    baseMaterials?: string[];
    dlcMaterials?: string[];
    noteHtml?: string;
};

const {
    baseDescription,
    dlcDescription,
    baseEquipment,
    dlcEquipment,
    baseOwner = [],
    dlcOwner = [],
    baseMaterials = [],
    dlcMaterials = [],
    noteHtml
} = Astro.props as EquipmentWikiProps;

import EditionSplit from './EditionSplit.astro';
import SectionTitle from './SectionTitle.astro';
import EquipmentStats from './EquipmentStats.jsx';
import TraitNote from './TraitNote.astro';
import WikiLink from './WikiLink.astro';


const hasEquipment = (e?: EquipmentData) => !!e && Object.values(e).some((v) => !!v && Object.keys(v).length > 0);
const hasOwner = (o?: string[]) => !!o && o.length > 0;
const hasMaterials = (m?: string[]) => !!m && m.length > 0;

const showBaseDesc = !!baseDescription && baseDescription.length > 0;
const showDlcDesc = !!dlcDescription && dlcDescription.length > 0;
const showBaseEquip = hasEquipment(baseEquipment);
const showDlcEquip = hasEquipment(dlcEquipment);
const showBaseOwner = hasOwner(baseOwner);
const showDlcOwner = hasOwner(dlcOwner);
const showBaseMaterials = hasMaterials(baseMaterials);
const showDlcMaterials = hasMaterials(dlcMaterials);
---

{/* ==================== 说明 ==================== */}
{
    (showBaseDesc || showDlcDesc) && (
        <>
            <SectionTitle>说明</SectionTitle>
            <EditionSplit showBase={showBaseDesc} showDlc={showDlcDesc}>
                <p slot="base" class="whitespace-pre-line text-base leading-relaxed">{baseDescription}</p>
                <p slot="dlc" class="whitespace-pre-line text-base leading-relaxed">{dlcDescription}</p>
            </EditionSplit>
        </>
    )
}

{/* ==================== 效果 ==================== */}
{
    (showBaseEquip || showDlcEquip) && (
        <>
            <SectionTitle>效果</SectionTitle>
            <EditionSplit showBase={showBaseEquip} showDlc={showDlcEquip}>
                <EquipmentStats slot="base" equipment={baseEquipment} />
                <EquipmentStats slot="dlc" equipment={dlcEquipment} />
            </EditionSplit>
        </>
    )
}

{/* ==================== 正主 ==================== */}
{
    (showBaseOwner || showDlcOwner) && (
        <>
            <SectionTitle>正主</SectionTitle>
            <EditionSplit showBase={showBaseOwner} showDlc={showDlcOwner}>
                <div slot="base" class="flex flex-col items-start gap-1">
                    {baseOwner.map((name) => <WikiLink kind="character" name={name} />)}
                </div>
                <div slot="dlc" class="flex flex-col items-start gap-1">
                    {dlcOwner.map((name) => <WikiLink kind="character" name={name} />)}
                </div>
            </EditionSplit>
        </>
    )
}

{/* ==================== 素材 ==================== */}
{
    (showBaseMaterials || showDlcMaterials) && (
        <>
            <SectionTitle>素材</SectionTitle>
            <EditionSplit showBase={showBaseMaterials} showDlc={showDlcMaterials}>
                <table slot="base" class="wiki-table wiki-table--list not-prose mt-2 max-w-[20rem]">
                    <tbody>
                        {baseMaterials.map((item) => (
                            <tr>
                                <td>
                                    <WikiLink kind="item" name={item} bare />
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
                <table slot="dlc" class="wiki-table wiki-table--list not-prose mt-2 max-w-[20rem]">
                    <tbody>
                        {dlcMaterials.map((item) => (
                            <tr>
                                <td>
                                    <WikiLink kind="item" name={item} bare />
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </EditionSplit>
        </>
    )
}

<TraitNote noteHtml={noteHtml} />
