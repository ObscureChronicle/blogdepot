---
type Props = {
    parents?: string[];
    upgrades?: string[];
    condition?: string[];
};

const { parents, upgrades, condition } = Astro.props as Props;

import { CLASS_MAP } from './classMap.js';

const getClassLink = (name: string) => {
    return CLASS_MAP[name as keyof typeof CLASS_MAP] || null;
};
---

{
    (parents && parents.length > 0) || (upgrades && upgrades.length > 0) || (condition && condition.length > 0) ? (
        <>
            <h2 class="bg-blue-100 text-blue-800 text-2xl font-bold px-2.5 pt-1.5 rounded-sm dark:bg-blue-200 dark:text-blue-800 inline-block">兵种树</h2>
            <div class="flex flex-col pl-4 gap-4">
                {parents && parents.length > 0 && (
                    <div class="flex flex-col items-start">
                        <span class="bg-blue-100 text-blue-800 text-base font-medium px-1.5 pt-1 rounded-sm dark:bg-blue-900 dark:text-blue-300">前置兵种</span>
                        <p class="text-base leading-relaxed">
                            {parents.map((name, index) => (
                                <span>
                                    {index > 0 && '、'}
                                    {getClassLink(name) ? (
                                        <a href={getClassLink(name) || ''} class="text-blue-600 hover:text-blue-800 hover:underline">
                                            {name}
                                        </a>
                                    ) : (
                                        <span>{name}</span>
                                    )}
                                </span>
                            ))}
                        </p>
                    </div>
                )}
                {condition && condition.length > 0 && (
                    <div class="flex flex-col items-start">
                        <p class="text-base leading-relaxed">转职条件：</p>
                        {condition.map((c) => (
                            <p class="text-base leading-relaxed pl-4">{c}</p>
                        ))}
                    </div>
                )}
                {upgrades && upgrades.length > 0 && (
                    <div class="flex flex-col items-start">
                        <span class="bg-green-100 text-green-800 text-base font-medium px-1.5 pt-1 rounded-sm dark:bg-green-900 dark:text-green-300">
                            可转职兵种
                        </span>
                        <p class="text-base leading-relaxed">
                            {upgrades.map((name, index) => (
                                <span>
                                    {index > 0 && '、'}
                                    {getClassLink(name) ? (
                                        <a href={getClassLink(name) || ''} class="text-blue-600 hover:text-blue-800 hover:underline">
                                            {name}
                                        </a>
                                    ) : (
                                        <span>{name}</span>
                                    )}
                                </span>
                            ))}
                        </p>
                    </div>
                )}
            </div>
        </>
    ) : null
}
