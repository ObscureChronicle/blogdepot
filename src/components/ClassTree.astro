---
import type { Edition } from '../data/editions';
import SectionTitle from './SectionTitle.astro';

type Props = {
    parents?: string[];
    upgrades?: string[];
    condition?: string[];
    /** 兵种页按版本分区时的标题配色 */
    tone?: Edition;
    treeTitle?: string;
    upgradesLabel?: string;
    conditionitemLabel?: string;
    conditionLabel?: string;
};

const { parents, upgrades, condition, tone, treeTitle, upgradesLabel, conditionitemLabel, conditionLabel } = Astro.props as Props;

import LinkedNames from './LinkedNames.astro';
---

{
    (parents && parents.length > 0) || (upgrades && upgrades.length > 0) || (condition && condition.length > 0) ? (
        <>
            <SectionTitle tone={tone}>{treeTitle || '兵种树'}</SectionTitle>
            <div class="flex flex-col pl-4 gap-4">
                {parents && parents.length > 0 && (
                    <div class="flex flex-col items-start">
                        <span class="bg-blue-100 text-blue-800 text-base font-medium px-1.5 pt-1 rounded-sm dark:bg-blue-900 dark:text-blue-300">
                            {conditionitemLabel || '前置兵种'}
                        </span>
                        <p class="text-base leading-relaxed">
                            <LinkedNames kind="class" names={parents} />
                        </p>
                    </div>
                )}
                {condition && condition.length > 0 && (
                    <div class="flex flex-col items-start">
                        <span class="bg-green-100 text-green-800 text-base font-medium px-1.5 pt-1 rounded-sm dark:bg-green-900 dark:text-green-300">
                            {conditionLabel || '转职条件'}
                        </span>
                        {condition.map((c) => (
                            <p class="text-base leading-relaxed pl-4">{c}</p>
                        ))}
                    </div>
                )}
                {upgrades && upgrades.length > 0 && (
                    <div class="flex flex-col items-start">
                        <span class="bg-green-100 text-green-800 text-base font-medium px-1.5 pt-1 rounded-sm dark:bg-green-900 dark:text-green-300">
                            {upgradesLabel || '可转职兵种'}
                        </span>
                        <p class="text-base leading-relaxed">
                            <LinkedNames kind="class" names={upgrades} />
                        </p>
                    </div>
                )}
            </div>
        </>
    ) : null
}
