---
import owners from '../../scripts/class-owners.json';
import { CHARACTER_MAP } from './characterMap.js';

const getLink = (name: string) => (CHARACTER_MAP as Record<string, string>)[name] || null;

// ============================================================
// 兵种总表：顺序 = 显示顺序；tier：base=基础，mid=中阶，high=高阶
// ============================================================
type Tier = 'base' | 'mid' | 'high';

const CLASS_DATA: { name: string; category: string; tier: Tier }[] = [
    // 民兵类
    { name: '民兵', category: '民兵类', tier: 'base' },
    { name: '贼兵', category: '民兵类', tier: 'base' },
    { name: '平民', category: '民兵类', tier: 'base' },

    // 刀兵类
    { name: '刀兵', category: '刀兵类', tier: 'base' },
    { name: '重装刀兵', category: '刀兵类', tier: 'mid' },
    { name: '近卫刀兵', category: '刀兵类', tier: 'mid' },
    { name: '长牌刀兵', category: '刀兵类', tier: 'mid' },
    { name: '突袭刀兵', category: '刀兵类', tier: 'mid' },
    { name: '免铠刀兵', category: '刀兵类', tier: 'mid' },
    { name: '虎兵', category: '刀兵类', tier: 'mid' },
    { name: '亲卫队', category: '刀兵类', tier: 'high' },
    { name: '施令刀兵', category: '刀兵类', tier: 'high' },
    { name: '死士', category: '刀兵类', tier: 'high' },

    // 矛兵类
    { name: '矛兵', category: '矛兵类', tier: 'base' },
    { name: '重装矛兵', category: '矛兵类', tier: 'mid' },
    { name: '荷剑矛兵', category: '矛兵类', tier: 'mid' },
    { name: '征召矛兵', category: '矛兵类', tier: 'mid' },
    { name: '结阵矛兵', category: '矛兵类', tier: 'mid' },
    { name: '戟兵', category: '矛兵类', tier: 'mid' },
    { name: '掷矛兵', category: '矛兵类', tier: 'mid' },
    { name: '义从矛兵', category: '矛兵类', tier: 'high' },
    { name: '方阵矛兵', category: '矛兵类', tier: 'high' },
    { name: '重装戟兵', category: '矛兵类', tier: 'high' },
    { name: '长戟兵', category: '矛兵类', tier: 'high' },
    { name: '宿卫队', category: '矛兵类', tier: 'high' },

    // 弓兵类
    { name: '弓兵', category: '弓兵类', tier: 'base' },
    { name: '重装弓兵', category: '弓兵类', tier: 'mid' },
    { name: '强弓兵', category: '弓兵类', tier: 'mid' },
    { name: '弩兵', category: '弓兵类', tier: 'mid' },
    { name: '游侠弓兵', category: '弓兵类', tier: 'mid' },
    { name: '负盾弓兵', category: '弓兵类', tier: 'mid' },
    { name: '禁卫队', category: '弓兵类', tier: 'high' },
    { name: '施令弓兵', category: '弓兵类', tier: 'high' },
    { name: '重装弩兵', category: '弓兵类', tier: 'high' },
    { name: '施令弩兵', category: '弓兵类', tier: 'high' },
    { name: '施令射楼', category: '弓兵类', tier: 'high' },

    // 刀骑兵类
    { name: '刀骑兵', category: '刀骑兵类', tier: 'base' },
    { name: '斥候刀骑', category: '刀骑兵类', tier: 'mid' },
    { name: '驿传刀骑', category: '刀骑兵类', tier: 'mid' },
    { name: '重甲刀骑', category: '刀骑兵类', tier: 'mid' },
    { name: '精锐刀骑', category: '刀骑兵类', tier: 'mid' },
    { name: '斧骑兵', category: '刀骑兵类', tier: 'mid' },
    { name: '骠骑兵', category: '刀骑兵类', tier: 'mid' },
    { name: '劫掠刀骑', category: '刀骑兵类', tier: 'high' },
    { name: '玄甲斧骑', category: '刀骑兵类', tier: 'high' },
    { name: '虎豹骑', category: '刀骑兵类', tier: 'high' },

    // 矛骑兵类
    { name: '矛骑兵', category: '矛骑兵类', tier: 'base' },
    { name: '重甲矛骑', category: '矛骑兵类', tier: 'mid' },
    { name: '阵战矛骑', category: '矛骑兵类', tier: 'mid' },
    { name: '长矛骑', category: '矛骑兵类', tier: 'mid' },
    { name: '先锋矛骑', category: '矛骑兵类', tier: 'mid' },
    { name: '敢死矛骑', category: '矛骑兵类', tier: 'mid' },
    { name: '骁骑兵', category: '矛骑兵类', tier: 'mid' },
    { name: '突骑兵', category: '矛骑兵类', tier: 'mid' },
    { name: '决死矛骑', category: '矛骑兵类', tier: 'high' },
    { name: '长矛铁骑', category: '矛骑兵类', tier: 'high' },
    { name: '具装突骑', category: '矛骑兵类', tier: 'high' },
    { name: '精锐突骑', category: '矛骑兵类', tier: 'high' },
    { name: '象兵', category: '矛骑兵类', tier: 'high' },

    // 弓骑兵类
    { name: '弓骑兵', category: '弓骑兵类', tier: 'base' },
    { name: '重甲弓骑', category: '弓骑兵类', tier: 'mid' },
    { name: '强弓骑', category: '弓骑兵类', tier: 'mid' },
    { name: '游袭弓骑', category: '弓骑兵类', tier: 'mid' },
    { name: '弩骑兵', category: '弓骑兵类', tier: 'mid' },
    { name: '马上重弩兵', category: '弓骑兵类', tier: 'mid' },
    { name: '胡服骑兵', category: '弓骑兵类', tier: 'mid' },
    { name: '西羌弓骑', category: '弓骑兵类', tier: 'high' },
    { name: '西域弓骑', category: '弓骑兵类', tier: 'high' },
    { name: '浮图弩骑', category: '弓骑兵类', tier: 'high' },

    // 器械类
    { name: '工兵', category: '器械类', tier: 'base' },
    { name: '辎重队', category: '器械类', tier: 'base' },
    { name: '井阑', category: '器械类', tier: 'mid' },
    { name: '床弩', category: '器械类', tier: 'mid' },
    { name: '车兵', category: '器械类', tier: 'mid' },
    { name: '发石车', category: '器械类', tier: 'high' }
];

// 大类显示顺序
const CATEGORY_ORDER = ['民兵类', '刀兵类', '矛兵类', '弓兵类', '刀骑兵类', '矛骑兵类', '弓骑兵类', '器械类'];

// 从 CLASS_DATA 派生：顺序、大类、阶位
const orderIndex = new Map(CLASS_DATA.map((c, i) => [c.name, i]));
const categoryMap = new Map(CLASS_DATA.map((c) => [c.name, c.category]));
const tierMap = new Map(CLASS_DATA.map((c) => [c.name, c.tier]));
const catIndex = new Map(CATEGORY_ORDER.map((name, i) => [name, i]));

// 阶位 → 文字颜色类
const tierClassMap: Record<Tier, string> = {
    base: '', // 默认
    mid: 'text-orange-300', // 中阶：肉色
    high: 'text-red-600' // 高阶：红色
};
const getTierClass = (cls: string) => tierClassMap[tierMap.get(cls) ?? 'base'];

// 按 CLASS_DATA 顺序排出 owners 里的兵种
const sortedClasses = Object.keys(owners).sort((a, b) => {
    const ia = orderIndex.get(a) ?? Number.MAX_SAFE_INTEGER;
    const ib = orderIndex.get(b) ?? Number.MAX_SAFE_INTEGER;
    if (ia !== ib) return ia - ib;
    return a.localeCompare(b, 'zh-Hans');
});

// 按大类分组
type ClassItem = {
    cls: string;
    base: string[];
    dlc: string[];
    hasBase: boolean;
    hasDlc: boolean;
    hasBoth: boolean;
    rowCount: number;
};

const groupMap = new Map<string, ClassItem[]>();

for (const cls of sortedClasses) {
    const data = owners[cls as keyof typeof owners];
    const hasBase = data.base.length > 0;
    const hasDlc = data.dlc.length > 0;

    const item: ClassItem = {
        cls,
        base: data.base,
        dlc: data.dlc,
        hasBase,
        hasDlc,
        hasBoth: hasBase && hasDlc,
        rowCount: (hasBase ? 1 : 0) + (hasDlc ? 1 : 0)
    };

    const category = categoryMap.get(cls) ?? '未分类';
    if (!groupMap.has(category)) groupMap.set(category, []);
    groupMap.get(category)!.push(item);
}

// 小类视图分组
const groups = Array.from(groupMap.entries())
    .map(([category, classes]) => ({
        category,
        classes,
        totalRows: classes.reduce((sum, c) => sum + c.rowCount, 0)
    }))
    .sort((a, b) => {
        const ia = catIndex.get(a.category) ?? Number.MAX_SAFE_INTEGER;
        const ib = catIndex.get(b.category) ?? Number.MAX_SAFE_INTEGER;
        if (ia !== ib) return ia - ib;
        return a.category.localeCompare(b.category, 'zh-Hans');
    });

// 大类视图分组：合并同大类下所有兵种的人物，去重
const categoryGroups = groups.map((group) => {
    const baseSet = new Set<string>();
    const dlcSet = new Set<string>();
    for (const item of group.classes) {
        for (const n of item.base) baseSet.add(n);
        for (const n of item.dlc) dlcSet.add(n);
    }
    const baseNames = Array.from(baseSet);
    const dlcNames = Array.from(dlcSet);
    const hasBase = baseNames.length > 0;
    const hasDlc = dlcNames.length > 0;
    return {
        category: group.category,
        baseNames,
        dlcNames,
        hasBase,
        hasDlc,
        totalRows: (hasBase ? 1 : 0) + (hasDlc ? 1 : 0)
    };
});

const thClass = 'px-3 py-2 text-center bg-gray-100 font-semibold text-gray-800 border border-gray-300';
const tdClass = 'px-3 py-2 border border-gray-200 align-middle';
const tdCenter = `${tdClass} text-center font-medium whitespace-nowrap`;
const linkClass = 'text-blue-600 hover:text-blue-800 hover:underline';
---

<div class="mb-3 flex justify-end">
    <button
        id="view-toggle"
        type="button"
        class="px-4 py-2 rounded-md border border-gray-300 bg-white text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 active:bg-gray-100 transition-colors"
    >
        切换大类/小类兵种
    </button>
</div>

<!-- ============ 小类视图（默认显示） ============ -->
<div id="view-class">
    <div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm">
        <table class="w-full border-collapse text-sm">
            <thead>
                <tr>
                    <th class={thClass}>大类</th>
                    <th class={thClass}>兵种</th>
                    <th class={thClass}>来源</th>
                    <th class={thClass}>人物</th>
                </tr>
            </thead>
            <tbody>
                {
                    groups.map((group) => (
                        <>
                            {group.classes.map((item, clsIndex) => (
                                <>
                                    {item.hasBase && (
                                        <tr>
                                            {clsIndex === 0 && (
                                                <td rowspan={group.totalRows} class={tdCenter}>
                                                    {group.category}
                                                </td>
                                            )}
                                            <td rowspan={item.hasBoth ? 2 : 1} class={`${tdCenter} ${getTierClass(item.cls)}`}>
                                                {item.cls}
                                            </td>
                                            <td class={`${tdClass} text-center whitespace-nowrap font-semibold text-blue-600`}>本体</td>
                                            <td class={tdClass}>
                                                {item.base.map((name, index) => (
                                                    <span>
                                                        {index > 0 && '、'}
                                                        {getLink(name) ? (
                                                            <a href={getLink(name) || ''} class={linkClass}>
                                                                {name}
                                                            </a>
                                                        ) : (
                                                            <span>{name}</span>
                                                        )}
                                                    </span>
                                                ))}
                                            </td>
                                        </tr>
                                    )}

                                    {item.hasDlc && (
                                        <tr>
                                            {clsIndex === 0 && !item.hasBase && (
                                                <td rowspan={group.totalRows} class={tdCenter}>
                                                    {group.category}
                                                </td>
                                            )}
                                            {!item.hasBase && (
                                                <td rowspan={1} class={`${tdCenter} ${getTierClass(item.cls)}`}>
                                                    {item.cls}
                                                </td>
                                            )}
                                            <td class={`${tdClass} text-center whitespace-nowrap font-semibold text-amber-500`}>星命诀</td>
                                            <td class={tdClass}>
                                                {item.dlc.map((name, index) => (
                                                    <span>
                                                        {index > 0 && '、'}
                                                        {getLink(name) ? (
                                                            <a href={getLink(name) || ''} class={linkClass}>
                                                                {name}
                                                            </a>
                                                        ) : (
                                                            <span>{name}</span>
                                                        )}
                                                    </span>
                                                ))}
                                            </td>
                                        </tr>
                                    )}
                                </>
                            ))}
                        </>
                    ))
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ============ 大类视图（默认隐藏） ============ -->
<div id="view-category" class="hidden">
    <div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm">
        <table class="w-full border-collapse text-sm">
            <thead>
                <tr>
                    <th class={thClass}>大类</th>
                    <th class={thClass}>来源</th>
                    <th class={thClass}>人物</th>
                </tr>
            </thead>
            <tbody>
                {
                    categoryGroups.map((g) => (
                        <>
                            {g.hasBase && (
                                <tr>
                                    <td rowspan={g.totalRows} class={tdCenter}>
                                        {g.category}
                                    </td>
                                    <td class={`${tdClass} text-center whitespace-nowrap font-semibold text-blue-600`}>本体</td>
                                    <td class={tdClass}>
                                        {g.baseNames.map((name, index) => (
                                            <span>
                                                {index > 0 && '、'}
                                                {getLink(name) ? (
                                                    <a href={getLink(name) || ''} class={linkClass}>
                                                        {name}
                                                    </a>
                                                ) : (
                                                    <span>{name}</span>
                                                )}
                                            </span>
                                        ))}
                                    </td>
                                </tr>
                            )}

                            {g.hasDlc && (
                                <tr>
                                    {!g.hasBase && (
                                        <td rowspan={g.totalRows} class={tdCenter}>
                                            {g.category}
                                        </td>
                                    )}
                                    <td class={`${tdClass} text-center whitespace-nowrap font-semibold text-amber-500`}>星命诀</td>
                                    <td class={tdClass}>
                                        {g.dlcNames.map((name, index) => (
                                            <span>
                                                {index > 0 && '、'}
                                                {getLink(name) ? (
                                                    <a href={getLink(name) || ''} class={linkClass}>
                                                        {name}
                                                    </a>
                                                ) : (
                                                    <span>{name}</span>
                                                )}
                                            </span>
                                        ))}
                                    </td>
                                </tr>
                            )}
                        </>
                    ))
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    const btn = document.getElementById('view-toggle');
    const viewClass = document.getElementById('view-class');
    const viewCategory = document.getElementById('view-category');

    btn?.addEventListener('click', () => {
        viewClass?.classList.toggle('hidden');
        viewCategory?.classList.toggle('hidden');
    });
</script>
