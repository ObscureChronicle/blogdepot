// 兵种 → 大类 映射
const CLASS_CATEGORY: Record<string, string> = {
    民兵: '民兵类',
    贼兵: '民兵类',
    平民: '民兵类',

    刀兵: '刀兵类',
    重装刀兵: '刀兵类',
    近卫刀兵: '刀兵类',
    长牌刀兵: '刀兵类',
    突袭刀兵: '刀兵类',
    免铠刀兵: '刀兵类',
    虎兵: '刀兵类',
    亲卫队: '刀兵类',
    施令刀兵: '刀兵类',
    死士: '刀兵类',

    矛兵: '矛兵类',
    重装矛兵: '矛兵类',
    荷剑矛兵: '矛兵类',
    征召矛兵: '矛兵类',
    结阵矛兵: '矛兵类',
    戟兵: '矛兵类',
    掷矛兵: '矛兵类',
    义从矛兵: '矛兵类',
    方阵矛兵: '矛兵类',
    重装戟兵: '矛兵类',
    长戟兵: '矛兵类',
    宿卫队: '矛兵类',

    弓兵: '弓兵类',
    重装弓兵: '弓兵类',
    强弓兵: '弓兵类',
    弩兵: '弓兵类',
