---
type Props = {
    classType?: string;
    titleClass?: string;
};

const { classType, titleClass } = Astro.props as Props;
---

{
    classType && classType.length > 0 ? (
        <>
            <h2 class={`${titleClass || 'bg-blue-100 text-blue-800 dark:bg-blue-200 dark:text-blue-800'} text-2xl font-bold px-2.5 pt-1.5 rounded-sm inline-block`}>兵种类型</h2>
            <p class="text-base leading-relaxed">{classType}</p>
        </>
    ) : null
}
