---
import type { Edition } from '../data/editions';
import SectionTitle from './SectionTitle.astro';

type Props = {
    classType?: string;
    /** 兵种页按版本分区时的标题配色 */
    tone?: Edition;
};

const { classType, tone } = Astro.props as Props;
---

{
    classType && classType.length > 0 ? (
        <>
            <SectionTitle tone={tone}>兵种类型</SectionTitle>
            <p class="text-base leading-relaxed">{classType}</p>
        </>
    ) : null
}
