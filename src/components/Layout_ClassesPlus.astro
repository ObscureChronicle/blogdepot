---
type ClassData = {
    description?: string;
    weapons?: string[];
    classType?: string;
    skills?: string[];
    params?: { label: string; value: string | number }[];
    parents?: string[];
    upgrades?: string[];
    condition?: string[];
};

type ClassWikiPlusProps = {
    base?: ClassData;
    dlc?: ClassData;
    collab?: ClassData;
};

const { base, dlc, collab } = Astro.props as ClassWikiPlusProps;

import ClassDescription from './ClassDescription.astro';
import ClassParams from './ClassParams.astro';
import ClassSkills from './ClassSkills.astro';
import ClassTree from './ClassTree.astro';
import ClassType from './ClassType.astro';
import ClassWeapons from './ClassWeapons.astro';

const sections = [
    { title: '本传', data: base, titleClass: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-300' },
    { title: '联动', data: collab, titleClass: 'bg-pink-100 text-red-800 dark:bg-pink-900 dark:text-red-300' },
    {
        title: '星命诀',
        data: dlc,
        titleClass: 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-300',
        treeTitle: '详情',
        upgradesLabel: '可变化阵势',
        conditionitemLabel: '解锁道具',
        conditionLabel: '解锁条件'
    }
];
---

{
    sections.map(
        (section) =>
            section.data && (
                <>
                    <h2 class={`${section.titleClass} text-3xl font-bold px-3 pt-2 pb-1 rounded-sm inline-block`}>{section.title}</h2>
                    <ClassDescription description={section.data.description || ''} hideTitle={true} />
                    <ClassWeapons weapons={section.data.weapons || []} titleClass={section.titleClass} />
                    <ClassType classType={section.data.classType || ''} titleClass={section.titleClass} />
                    <ClassSkills skills={section.data.skills || []} titleClass={section.titleClass} />
                    <ClassParams params={section.data.params || []} titleClass={section.titleClass} />
                    <ClassTree
                        parents={section.data.parents || []}
                        upgrades={section.data.upgrades || []}
                        condition={section.data.condition || []}
                        titleClass={section.titleClass}
                        treeTitle={section.treeTitle}
                        upgradesLabel={section.upgradesLabel}
                        conditionitemLabel={section.conditionitemLabel}
                        conditionLabel={section.conditionLabel}
                    />
                </>
            )
    )
}
