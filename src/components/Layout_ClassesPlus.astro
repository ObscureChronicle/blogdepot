---
import ClassSection, { type ClassData } from './ClassSection.astro';
import TraitOwner from './TraitOwner.astro';
import { EDITIONS, type Edition } from '../data/editions';

type ClassWikiPlusProps = {
    base?: ClassData;
    dlc?: ClassData;
    collab?: ClassData;
    baseOwner?: string[];
    dlcOwner?: string[];
    collabOwner?: string[];
};

const { base, dlc, collab, baseOwner, dlcOwner, collabOwner } = Astro.props as ClassWikiPlusProps;

type Section = {
    tone: Edition;
    title: string;
    data?: ClassData;
    /** 分区大标题（本传 / 星命诀 / 联动）的配色 */
    titleClass: string;
    treeTitle?: string;
    upgradesLabel?: string;
    parentsLabel?: string;
    conditionLabel?: string;
};

const sections: Section[] = [
    { tone: 'base', title: EDITIONS.base.shortName, data: base, titleClass: EDITIONS.base.badgeColor },
    { tone: 'collab', title: EDITIONS.collab.shortName, data: collab, titleClass: EDITIONS.collab.badgeColor },
    {
        tone: 'dlc',
        title: EDITIONS.dlc.shortName,
        data: dlc,
        titleClass: EDITIONS.dlc.badgeColor,
        treeTitle: '详情',
        upgradesLabel: '可变化阵势',
        parentsLabel: '解锁道具',
        conditionLabel: '解锁条件'
    }
];
---

<TraitOwner baseOwner={baseOwner || []} dlcOwner={dlcOwner || []} collabOwner={collabOwner || []} />
{
    sections.map(
        (section) =>
            section.data && (
                <>
                    <h2 class={`${section.titleClass} text-3xl font-bold px-3 pt-2 pb-1 rounded-sm inline-block`}>{section.title}</h2>
                    <ClassSection
                        data={section.data}
                        tone={section.tone}
                        showDescriptionTitle={false}
                        treeTitle={section.treeTitle}
                        upgradesLabel={section.upgradesLabel}
                        parentsLabel={section.parentsLabel}
                        conditionLabel={section.conditionLabel}
                    />
                </>
            )
    )
}
