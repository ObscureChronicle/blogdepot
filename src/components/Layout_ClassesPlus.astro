---
type ClassData = {
    description?: string;
    weapons?: string[];
    classType?: string;
    skills?: string[];
    params?: { label: string; value: string | number }[];
    parents?: string[];
    upgrades?: string[];
    condition?: string[];
};

type ClassWikiPlusProps = {
    base?: ClassData;
    dlc?: ClassData;
    collab?: ClassData;
    baseOwner?: string[];
    dlcOwner?: string[];
    collabOwner?: string[];
};

const { base, dlc, collab, baseOwner, dlcOwner, collabOwner } = Astro.props as ClassWikiPlusProps;

import ClassDescription from './ClassDescription.astro';
import ClassParams from './ClassParams.astro';
import ClassSkills from './ClassSkills.astro';
import ClassTree from './ClassTree.astro';
import ClassType from './ClassType.astro';
import ClassWeapons from './ClassWeapons.astro';
import TraitOwner from './TraitOwner.astro';
import { EDITIONS, type Edition } from '../data/editions';

type Section = {
    tone: Edition;
    title: string;
    data?: ClassData;
    /** 分区大标题（本传 / 星命诀 / 联动）的配色 */
    titleClass: string;
    treeTitle?: string;
    upgradesLabel?: string;
    conditionitemLabel?: string;
    conditionLabel?: string;
};

const sections: Section[] = [
    { tone: 'base', title: EDITIONS.base.shortName, data: base, titleClass: EDITIONS.base.badgeColor },
    { tone: 'collab', title: EDITIONS.collab.shortName, data: collab, titleClass: EDITIONS.collab.badgeColor },
    {
        tone: 'dlc',
        title: EDITIONS.dlc.shortName,
        data: dlc,
        titleClass: EDITIONS.dlc.badgeColor,
        treeTitle: '详情',
        upgradesLabel: '可变化阵势',
        conditionitemLabel: '解锁道具',
        conditionLabel: '解锁条件'
    }
];
---

<TraitOwner baseOwner={baseOwner || []} dlcOwner={dlcOwner || []} collabOwner={collabOwner || []} />
{
    sections.map(
        (section) =>
            section.data && (
                <>
                    <h2 class={`${section.titleClass} text-3xl font-bold px-3 pt-2 pb-1 rounded-sm inline-block`}>{section.title}</h2>
                    <ClassDescription description={section.data.description || ''} hideTitle={true} />
                    <ClassWeapons weapons={section.data.weapons || []} tone={section.tone} />
                    <ClassType classType={section.data.classType || ''} tone={section.tone} />
                    <ClassSkills skills={section.data.skills || []} tone={section.tone} />
                    <ClassParams params={section.data.params || []} tone={section.tone} />
                    <ClassTree
                        parents={section.data.parents || []}
                        upgrades={section.data.upgrades || []}
                        condition={section.data.condition || []}
                        tone={section.tone}
                        treeTitle={section.treeTitle}
                        upgradesLabel={section.upgradesLabel}
                        conditionitemLabel={section.conditionitemLabel}
                        conditionLabel={section.conditionLabel}
                    />
                </>
            )
    )
}
