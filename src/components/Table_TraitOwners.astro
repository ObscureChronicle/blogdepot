---
import { TRAIT_OWNERS as traitOwners } from '../utils/wiki-owners';
import { TRAIT_MAP, TraitColor } from './Table_Traits.jsx';
import OwnerRows from './OwnerRows.astro';

type Props = {
    mode: 'personal' | 'regional';
};

const { mode } = Astro.props as Props;

const getTraitInfo = (trait: string) => (TRAIT_MAP as Record<string, { color?: string; link?: string }>)[trait] || null;

// 地域特性名单（与 trait_00_regional.mdx 一致）
const REGIONAL_TRAITS = new Set([
    '中原',
    '关中',
    '关陇',
    '河北',
    '青徐',
    '荆扬',
    '荆楚',
    '幽并',
    '巴蜀',
    '雍凉',
    '西凉',
    '淮泗',
    '吴越',
    '乌桓',
    '鲜卑',
    '匈奴',
    '西羌',
    '氐賨',
    '南蛮',
    '山越',
    '三韩'
]);

// 个人特性排序：顶级(Ordinary) → 专属(Super) → 普通 → 负面(Bad)，同级按拼音
const tierOrder = (trait: string) => {
    const color = getTraitInfo(trait)?.color;
    if (color === TraitColor.Oridinary) return 0;
    if (color === TraitColor.Super) return 1;
    if (color === TraitColor.Bad) return 3;
    return 2;
};

const allTraits = Object.keys(traitOwners);
const filtered = mode === 'regional' ? allTraits.filter((t) => REGIONAL_TRAITS.has(t)) : allTraits.filter((t) => !REGIONAL_TRAITS.has(t));

// 地域特性：地区分组与显示顺序
const REGION_ORDER = ['西北', '西南', '东南', '北部', '中部', '四夷'];
const getRegion = (trait: string) => (TRAIT_MAP as Record<string, { region?: string }>)[trait]?.region ?? '未分类';

const sortedTraits =
    mode === 'regional'
        ? filtered.sort((a, b) => {
              const oa = REGION_ORDER.indexOf(getRegion(a));
              const ob = REGION_ORDER.indexOf(getRegion(b));
              const ia = oa === -1 ? REGION_ORDER.length : oa;
              const ib = ob === -1 ? REGION_ORDER.length : ob;
              if (ia !== ib) return ia - ib;
              return a.localeCompare(b, 'zh-Hans');
          })
        : filtered.sort((a, b) => {
              const ta = tierOrder(a);
              const tb = tierOrder(b);
              if (ta !== tb) return ta - tb;
              return a.localeCompare(b, 'zh-Hans');
          });

// 各地区合并行数（含本传/星命诀拆分）
const regionRowspan = new Map<string, number>();
if (mode === 'regional') {
    for (const t of sortedTraits) {
        const d = traitOwners[t] ?? {};
        const rows = ((d.base?.length ?? 0) > 0 ? 1 : 0) + ((d.dlc?.length ?? 0) > 0 ? 1 : 0);
        const r = getRegion(t);
        regionRowspan.set(r, (regionRowspan.get(r) ?? 0) + rows);
    }
}

// 特质名样式：颜色 + 顶级(Ordinary)发光（与 Table_Traits.jsx 一致）
const traitStyle = (trait: string) => {
    const color = getTraitInfo(trait)?.color;
    const glow = color === TraitColor.Oridinary ? `; text-shadow: 0 0 8px ${color}, 0 0 12px ${color}` : '';
    return color ? `color: ${color}${glow}` : 'color: inherit';
};
---

<div class="overflow-x-auto">
    <table class="wiki-table wiki-table--merged not-prose">
        <thead>
            <tr>
                {mode === 'regional' && <th scope="col">地区</th>}
                <th scope="col">特质</th>
                <th scope="col">来源</th>
                <th scope="col">人物</th>
            </tr>
        </thead>
        <tbody>
            {
                sortedTraits.map((trait, traitIndex) => {
                    const data = traitOwners[trait] ?? {};
                    const info = getTraitInfo(trait);
                    const region = getRegion(trait);
                    const isFirstInRegion = mode === 'regional' && (traitIndex === 0 || getRegion(sortedTraits[traitIndex - 1]) !== region);
                    return (
                        <OwnerRows base={data.base ?? []} dlc={data.dlc ?? []} groupRowspan={isFirstInRegion ? regionRowspan.get(region) : undefined}>
                            <Fragment slot="group">{region}</Fragment>
                            <Fragment slot="entity">
                                {info?.link ? (
                                    <a href={info.link} class="hover:underline" style={traitStyle(trait)}>
                                        {trait}
                                    </a>
                                ) : (
                                    <span style={info?.color ? traitStyle(trait) : undefined}>{trait}</span>
                                )}
                            </Fragment>
                        </OwnerRows>
                    );
                })
            }
        </tbody>
    </table>
</div>
