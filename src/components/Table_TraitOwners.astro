---
import { TRAIT_OWNERS as traitOwners, TRAIT_ENHANCED as traitEnhanced } from '../utils/wiki-owners';
import { TRAIT_LEVELS } from '../utils/trait-levels';
import { TRAIT_MAP, TraitColor, traitColorFromLevel } from '../data/trait-meta';
import OwnerRows from './OwnerRows.astro';

type Props = {
    mode: 'personal' | 'regional';
};

const { mode } = Astro.props as Props;

const getTraitInfo = (trait: string) => TRAIT_MAP[trait] ?? null;

// 特质颜色：强化别名（带 *）用 TRAIT_MAP 登记的配色，其余按词条 level 派生；普通特质不染色
const getTraitColor = (trait: string) => getTraitInfo(trait)?.color ?? traitColorFromLevel(TRAIT_LEVELS[trait]);

// 地域特性：TRAIT_MAP 中带 region（所属地区）的条目
const isRegional = (trait: string) => !!TRAIT_MAP[trait]?.region;

// 个人特性排序：顶级(level 1) → 专属(level 2) → 普通(不设) → 负面(level 3)，同级按拼音
const tierOrder = (trait: string) => {
    const level = TRAIT_LEVELS[trait];
    if (level === 1) return 0;
    if (level === 2) return 1;
    if (level === 3) return 3;
    return 2;
};

const allTraits = Object.keys(traitOwners);
const filtered = mode === 'regional' ? allTraits.filter(isRegional) : allTraits.filter((t) => !isRegional(t));

// 地域特性：地区分组与显示顺序
const REGION_ORDER = ['西北', '西南', '东南', '北部', '中部', '四夷'];
const getRegion = (trait: string) => TRAIT_MAP[trait]?.region ?? '未分类';

const sortedTraits =
    mode === 'regional'
        ? filtered.sort((a, b) => {
              const oa = REGION_ORDER.indexOf(getRegion(a));
              const ob = REGION_ORDER.indexOf(getRegion(b));
              const ia = oa === -1 ? REGION_ORDER.length : oa;
              const ib = ob === -1 ? REGION_ORDER.length : ob;
              if (ia !== ib) return ia - ib;
              return a.localeCompare(b, 'zh-Hans');
          })
        : filtered.sort((a, b) => {
              const ta = tierOrder(a);
              const tb = tierOrder(b);
              if (ta !== tb) return ta - tb;
              return a.localeCompare(b, 'zh-Hans');
          });

// 各地区合并行数（含本传/星命诀拆分）
const regionRowspan = new Map<string, number>();
if (mode === 'regional') {
    for (const t of sortedTraits) {
        const d = traitOwners[t] ?? {};
        const rows = ((d.base?.length ?? 0) > 0 ? 1 : 0) + ((d.dlc?.length ?? 0) > 0 ? 1 : 0);
        const r = getRegion(t);
        regionRowspan.set(r, (regionRowspan.get(r) ?? 0) + rows);
    }
}

// 特质名样式：颜色 + 顶级发光（与 Table_Traits.jsx 一致）
const traitStyle = (trait: string) => {
    const color = getTraitColor(trait);
    const glow = color === TraitColor.Ordinary ? `; text-shadow: 0 0 8px ${color}, 0 0 12px ${color}` : '';
    return color ? `color: ${color}${glow}` : 'color: inherit';
};
---

<div class="overflow-x-auto">
    <table class="wiki-table wiki-table--merged not-prose">
        <thead>
            <tr>
                {mode === 'regional' && <th scope="col">地区</th>}
                <th scope="col">特质</th>
                <th scope="col">来源</th>
                <th scope="col">人物</th>
            </tr>
        </thead>
        <tbody>
            {
                sortedTraits.map((trait, traitIndex) => {
                    const data = traitOwners[trait] ?? {};
                    const enhanced = traitEnhanced[trait] ?? {};
                    const info = getTraitInfo(trait);
                    const region = getRegion(trait);
                    const isFirstInRegion = mode === 'regional' && (traitIndex === 0 || getRegion(sortedTraits[traitIndex - 1]) !== region);
                    return (
                        <OwnerRows
                            base={data.base ?? []}
                            dlc={data.dlc ?? []}
                            baseEnhanced={enhanced.base ?? []}
                            dlcEnhanced={enhanced.dlc ?? []}
                            groupRowspan={isFirstInRegion ? regionRowspan.get(region) : undefined}
                        >
                            <Fragment slot="group">{region}</Fragment>
                            <Fragment slot="entity">
                                {info?.link ? (
                                    <a href={info.link} class="hover:underline" style={traitStyle(trait)}>
                                        {trait}
                                    </a>
                                ) : (
                                    <span style={getTraitColor(trait) ? traitStyle(trait) : undefined}>{trait}</span>
                                )}
                            </Fragment>
                        </OwnerRows>
                    );
                })
            }
        </tbody>
    </table>
</div>
