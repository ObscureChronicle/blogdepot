---
import SectionTitle from './SectionTitle.astro';

type Props = {
    description?: string;
    hideTitle?: boolean;
};

const { description, hideTitle } = Astro.props as Props;
---

{
    description && description.length > 0 ? (
        <>
            {!hideTitle && (
                <SectionTitle>说明</SectionTitle>
            )}
            <p set:html={description} class="text-base leading-relaxed" />
        </>
    ) : null
}
