---
// 用「、」分隔的一串百科名称，每个名称有词条时输出链接
import type { WikiLinkKind } from '../utils/wiki-link-parser';
import WikiLink from './WikiLink.astro';

type Props = {
    kind: WikiLinkKind;
    names: string[];
    /** 使用强化别名（带 *）的名字：保留干净名字做链接，在链接后标 * */
    enhanced?: string[];
};

const { kind, names, enhanced = [] } = Astro.props as Props;
const enhancedSet = new Set(enhanced);
---

{
    names.map((name, index) => (
        <span>
            {index > 0 && '、'}
            <WikiLink kind={kind} name={name} />{enhancedSet.has(name) && <sup>*</sup>}
        </span>
    ))
}
