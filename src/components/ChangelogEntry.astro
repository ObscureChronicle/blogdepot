---
// 更新日志的一个版本。items 的书写格式见 src/utils/changelog-parser.ts。
// 左侧竖线串起各版本形成时间轴；筛选、年份分隔、默认展开最新版由 ChangelogToolbar 的脚本负责，
// 所以这里在节点上写好 data-* 供脚本读取。
import { changelogTagClass, countChangelogCategories, parseChangelogItems } from '../utils/changelog-parser';

type Props = { version: string; date: string; items: string[]; initiallyOpen?: boolean };

const { version, date, items, initiallyOpen = false } = Astro.props;
const lines = parseChangelogItems(items);
const counts = countChangelogCategories(lines);
const total = lines.filter((line) => line.kind === 'item').length;
---

<details class="changelog-entry not-prose" id={version} data-changelog-entry data-year={date.slice(0, 4)} open={initiallyOpen}>
    <summary class="changelog-entry__summary">
        <span class="changelog-entry__version">{version}</span>
        <time class="changelog-entry__date" datetime={date.replaceAll('/', '-')}>{date}</time>
        <span class="changelog-entry__meta" data-changelog-meta>
            <span class="changelog-entry__total">{total} 项</span>
            {
                counts.map((c) => (
                    <span class:list={['changelog-tag changelog-entry__count', changelogTagClass(c.name)]}>
                        {c.name} {c.count}
                    </span>
                ))
            }
        </span>
        <span class="changelog-entry__meta" data-changelog-hits hidden></span>
    </summary>
    <ul class="changelog-entry__list">
        {
            lines.map((line) =>
                line.kind === 'remark' ? (
                    <li class="changelog-remark" data-changelog-item data-tags="">
                        <span data-changelog-text>{line.text}</span>
                    </li>
                ) : (
                    <li class="changelog-item" data-changelog-item data-tags={line.tags.join(' ')}>
                        {line.tags.length > 0 && (
                            <span class="changelog-item__tags">
                                {line.tags.map((tag) => (
                                    <span class:list={['changelog-tag', changelogTagClass(tag)]}>{tag}</span>
                                ))}
                            </span>
                        )}
                        <span class="changelog-item__body">
                            <span data-changelog-text>{line.text}</span>
                            {line.children.length > 0 && (
                                <ul class="changelog-item__children">
                                    {line.children.map((child) => (
                                        <li class={child.kind === 'note' ? 'changelog-note' : 'changelog-sub'}>
                                            <span data-changelog-text>{child.text}</span>
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </span>
                    </li>
                )
            )
        }
    </ul>
</details>

<style is:global>
    /* 筛选脚本会改写文字节点、插入年份分隔，这些节点没有 Astro 作用域属性，所以统一用全局类名 */
    .changelog-entry {
        --changelog-line: color-mix(in srgb, var(--text-main) 18%, transparent);
        position: relative;
        margin-left: 0.375rem;
        padding: 0 0 1rem 1.375rem;
        border-left: 2px solid var(--changelog-line);
        text-indent: 0;
        text-align: left;
    }
    /* 时间轴节点：折叠时空心，展开时实心 */
    .changelog-entry::before {
        content: '';
        position: absolute;
        left: -7px;
        top: 0.45rem;
        width: 12px;
        height: 12px;
        border-radius: 9999px;
        border: 2px solid color-mix(in srgb, var(--text-main) 45%, transparent);
        background: var(--bg-main);
    }
    .changelog-entry[open]::before {
        border-color: var(--text-main);
        background: var(--text-main);
    }

    .changelog-entry__summary {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        column-gap: 0.75rem;
        row-gap: 0.25rem;
        cursor: pointer;
        list-style: none;
        width: fit-content;
    }
    .changelog-entry__summary::-webkit-details-marker {
        display: none;
    }
    .changelog-entry__summary:focus-visible {
        outline: 2px solid var(--border-main);
        outline-offset: 2px;
    }
    .changelog-entry__version {
        font-size: 1.125rem;
        font-weight: 600;
    }
    .changelog-entry__date,
    .changelog-entry__total {
        font-size: 0.875rem;
        opacity: 0.7;
    }
    .changelog-entry__meta {
        display: inline-flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0.25rem 0.375rem;
        font-size: 0.875rem;
    }
    .changelog-entry__meta[data-changelog-hits] {
        opacity: 0.7;
    }
    /* 窄屏只保留「N 项」，各类别数量放不下 */
    @media (max-width: 639px) {
        .changelog-entry .changelog-entry__count {
            display: none;
        }
    }
    .changelog-entry[open] .changelog-entry__count {
        display: none;
    }

    .changelog-tag {
        display: inline-block;
        flex-shrink: 0;
        padding: 0.0625rem 0.375rem;
        border-radius: 0.25rem;
        font-size: 0.75rem;
        line-height: 1.25rem;
        white-space: nowrap;
    }

    .changelog-entry__list {
        margin-top: 0.625rem;
        font-size: 0.9375rem;
        line-height: 1.7;
    }
    .changelog-item {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
        padding: 0.125rem 0;
    }
    .changelog-item__tags {
        display: inline-flex;
        gap: 0.25rem;
        padding-top: 0.1875rem;
    }
    .changelog-item__body {
        flex: 1;
        min-width: 0;
    }
    .changelog-item__children {
        margin-top: 0.125rem;
        font-size: 0.875rem;
    }
    .changelog-sub {
        position: relative;
        padding-left: 0.875rem;
    }
    .changelog-sub::before {
        content: '·';
        position: absolute;
        left: 0.125rem;
    }
    .changelog-note {
        opacity: 0.65;
    }
    .changelog-remark {
        padding: 0.125rem 0 0.25rem;
        font-style: italic;
        opacity: 0.75;
    }
</style>
