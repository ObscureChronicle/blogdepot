---
// 军略词条布局。本传的军略存在等级（Ⅰ / Ⅱ / Ⅲ …），按等级列出效果；
// 星命诀的军略不分等级，只有一段描述与效果。
import { EDITIONS } from '../data/editions';
import { getSkillRelations } from '../utils/art-of-war-relations';
import { getWikiLink } from '../utils/wiki-links';
import SectionTitle from './SectionTitle.astro';
import TraitNote from './TraitNote.astro';

export type SkillRow = {
    /** 类型，如「增益型」「妨害型」 */
    type?: string;
    /** 分类，如「武勇类」「智略类」「统御类」「魅力类」 */
    category?: string;
    /** 技能种类，如「补正」「支援」「附加状态」 */
    skillType?: string;
    /** 对象，如「本队」「敌军一部队」「除本队外我军全体」 */
    target?: string;
    /** 成功率条件，如「100%」「(武勇)%」「Lv %」 */
    successRate?: string;
    /** 敌方对成功率的减益，如「(胆识×10)%」；无则留空 */
    targetResist?: string;
    /** 冷却时间，如「3回合」 */
    cooldown?: string;
    /** 持续时间，如「4回合」 */
    duration?: string;
    effect: string;
};

export type SkillLevel = SkillRow & {
    level: string;
};

type SkillWikiProps = {
    /** 本传的类型，如「增益型」「妨害型」 */
    baseType?: string;
    /** 本传的分类 */
    baseCategory?: string;
    /** 本传的技能种类 */
    baseSkillType?: string;
    baseDescription?: string;
    baseLevels?: SkillLevel[];
    /** 星命诀不分等级，除描述外的全部项目都放在这里，渲染为一张单行表格 */
    dlcSkill?: SkillRow;
    dlcDescription?: string;
    noteHtml?: string;
};

const { baseType, baseCategory, baseSkillType, baseDescription, baseLevels = [], dlcSkill, dlcDescription, noteHtml } = Astro.props as SkillWikiProps;

const hasBase = Boolean(baseType) || Boolean(baseCategory) || Boolean(baseSkillType) || Boolean(baseDescription) || baseLevels.length > 0;
const hasDlc = Boolean(dlcSkill) || Boolean(dlcDescription);

// 表格里没有数据的格子统一显示占位符
const EMPTY = '—';
const orEmpty = (value?: string) => (value && value.trim() ? value : EMPTY);

// 等级间变动高亮：与上一级比较，非效果列整格标记，效果列按分隔符逐项标记
const SEPARATOR = /([　\s]+)/;
const DIFF_CLASS = 'text-green-600 dark:text-green-400';

const tokenizeEffect = (effect: string) => effect.split(SEPARATOR).filter((part) => part.trim() !== '');

// 只有「附加状态」类军略的效果才是状态名，才需要链到 status 词条
const isBaseStatusSkill = baseSkillType === '附加状态';
const dlcEffectLink = dlcSkill?.skillType === '附加状态' ? getWikiLink('status', dlcSkill.effect.trim()) : null;

// 星命诀军略盘上的前置 / 后续 / 互斥关系：词条 id 形如 art-of-war/pozhu，取最后一段对应军略盘 slug
const relations = getSkillRelations(String(Astro.params.id ?? '').split('/').pop() ?? '');
const relationRows = relations
    ? [
          // 多个前置时习得其一即可（数据中不少军略的几个前置彼此互斥）
          { label: '前置军略', nodes: relations.prerequisites, hint: relations.prerequisites.length > 1 ? '（满足其一即可）' : null },
          { label: '后续军略', nodes: relations.unlocks, hint: null },
          { label: '互斥军略', nodes: relations.exclusives, hint: null }
      ]
    : [];

const levelRows = baseLevels.map((row, index) => {
    const previous = index > 0 ? baseLevels[index - 1] : undefined;
    const isChanged = (value?: string, previousValue?: string) => Boolean(previous) && (value ?? '') !== (previousValue ?? '');

    const previousTokens = previous ? tokenizeEffect(previous.effect) : [];
    let tokenIndex = 0;
    const effectParts = row.effect
        .split(SEPARATOR)
        .filter((part) => part !== '')
        .map((part) => {
            if (part.trim() === '') return { text: part, separator: true, changed: false };
            const changed = Boolean(previous) && (previousTokens[tokenIndex] ?? '') !== part;
            tokenIndex += 1;
            return { text: part, separator: false, changed };
        });

    return {
        row,
        changed: {
            target: isChanged(row.target, previous?.target),
            successRate: isChanged(row.successRate, previous?.successRate),
            targetResist: isChanged(row.targetResist, previous?.targetResist),
            cooldown: isChanged(row.cooldown, previous?.cooldown),
            duration: isChanged(row.duration, previous?.duration)
        },
        effectParts,
        effectChanged: effectParts.some((part) => part.changed),
        effectLink: isBaseStatusSkill ? getWikiLink('status', row.effect.trim()) : null
    };
});
---

{
    (hasBase || hasDlc) && (
        <>
            <SectionTitle>介绍</SectionTitle>
            <p>
                {hasBase && EDITIONS.base.name}
                {hasBase && hasDlc && '与'}
                {hasDlc && EDITIONS.dlc.name}中的军略。
            </p>
        </>
    )
}

{
    hasBase && (
        <>
            <SectionTitle edition="base">{EDITIONS.base.shortName}</SectionTitle>
            {(baseType || baseCategory || baseSkillType) && (
                <p class="text-base leading-relaxed">
                    {[baseType && `类型：${baseType}`, baseCategory && `分类：${baseCategory}`, baseSkillType && `军略小类：${baseSkillType}`]
                        .filter(Boolean)
                        .join('；')}
                </p>
            )}
            {baseDescription && <p set:html={baseDescription} class="text-base leading-relaxed" />}
            {baseLevels.length > 0 && (
                // 7 列在手机上放不下，放进横向滚动容器，避免撑宽整页
                <div class="mt-2 overflow-x-auto">
                    <table class="wiki-table wiki-table--hover not-prose">
                        <thead>
                            <tr>
                                <th scope="col" class="w-16">
                                    等级
                                </th>
                                <th scope="col">对象</th>
                                <th scope="col">成功率</th>
                                <th scope="col">目标减益</th>
                                <th scope="col">冷却时间</th>
                                <th scope="col">持续时间</th>
                                <th scope="col">效果</th>
                            </tr>
                        </thead>
                        <tbody>
                            {levelRows.map(({ row, changed, effectParts, effectChanged, effectLink }) => (
                                <tr>
                                    <th scope="row" class="w-16">
                                        {row.level}
                                    </th>
                                    <td>
                                        <span class={changed.target ? DIFF_CLASS : undefined}>{orEmpty(row.target)}</span>
                                    </td>
                                    <td>
                                        <span class={changed.successRate ? DIFF_CLASS : undefined}>{orEmpty(row.successRate)}</span>
                                    </td>
                                    <td>
                                        <span class={changed.targetResist ? DIFF_CLASS : undefined}>{orEmpty(row.targetResist)}</span>
                                    </td>
                                    <td>
                                        <span class={changed.cooldown ? DIFF_CLASS : undefined}>{orEmpty(row.cooldown)}</span>
                                    </td>
                                    <td>
                                        <span class={changed.duration ? DIFF_CLASS : undefined}>{orEmpty(row.duration)}</span>
                                    </td>
                                    <td>
                                        {effectLink ? (
                                            <a href={effectLink} class={effectChanged ? DIFF_CLASS : undefined}>{row.effect}</a>
                                        ) : (
                                            effectParts.map((part) =>
                                                part.separator || !part.changed ? part.text : <span class={DIFF_CLASS}>{part.text}</span>
                                            )
                                        )}
                                    </td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            )}
        </>
    )
}

{
    hasDlc && (
        <>
            <SectionTitle edition="dlc">{EDITIONS.dlc.shortName}</SectionTitle>
            {dlcDescription && <p set:html={dlcDescription} class="text-base leading-relaxed" />}
            {dlcSkill && (
                <table class="wiki-table wiki-table--hover not-prose mt-2 max-w-[30rem]">
                    <tbody>
                        <tr>
                            <th scope="row" class="w-28">
                                类型
                            </th>
                            <td>{orEmpty(dlcSkill.type)}</td>
                        </tr>
                        <tr>
                            <th scope="row" class="w-28">
                                分类
                            </th>
                            <td>{orEmpty(dlcSkill.category)}</td>
                        </tr>
                        <tr>
                            <th scope="row" class="w-28">
                                军略小类
                            </th>
                            <td>{orEmpty(dlcSkill.skillType)}</td>
                        </tr>
                        <tr>
                            <th scope="row" class="w-28">
                                对象
                            </th>
                            <td>{orEmpty(dlcSkill.target)}</td>
                        </tr>
                        <tr>
                            <th scope="row" class="w-28">
                                成功率
                            </th>
                            <td>{orEmpty(dlcSkill.successRate)}</td>
                        </tr>
                        <tr>
                            <th scope="row" class="w-28">
                                目标减益
                            </th>
                            <td>{orEmpty(dlcSkill.targetResist)}</td>
                        </tr>
                        <tr>
                            <th scope="row" class="w-28">
                                冷却时间
                            </th>
                            <td>{orEmpty(dlcSkill.cooldown)}</td>
                        </tr>
                        <tr>
                            <th scope="row" class="w-28">
                                持续时间
                            </th>
                            <td>{orEmpty(dlcSkill.duration)}</td>
                        </tr>
                        <tr>
                            <th scope="row" class="w-28">
                                效果
                            </th>
                            <td>{dlcEffectLink ? <a href={dlcEffectLink}>{dlcSkill.effect}</a> : dlcSkill.effect}</td>
                        </tr>
                        {relations && (
                            <>
                                <tr>
                                    <th scope="row" class="w-28">
                                        军略盘等级
                                    </th>
                                    <td>第 {relations.node.level} 级</td>
                                </tr>
                                {relationRows.map(({ label, nodes, hint }) => (
                                    <tr>
                                        <th scope="row" class="w-28">
                                            {label}
                                        </th>
                                        <td>
                                            {nodes.length === 0
                                                ? EMPTY
                                                : nodes.map((node, i) => (
                                                      <>
                                                          {i > 0 && '、'}
                                                          <a href={`/projects/art-of-war/${node.slug}/`}>{node.name}</a>
                                                      </>
                                                  ))}
                                            {hint && <span class="ml-1 text-sm opacity-70">{hint}</span>}
                                        </td>
                                    </tr>
                                ))}
                            </>
                        )}
                    </tbody>
                </table>
            )}
        </>
    )
}

<TraitNote noteHtml={noteHtml} />
