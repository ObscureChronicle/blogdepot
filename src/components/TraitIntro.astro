---
import SectionTitle from './SectionTitle.astro';
import { EDITIONS } from '../data/editions';

type Props = {
    baseData?: boolean;
    dlcData?: boolean;
    level?: number;
    introHtml?: string;
};

const { baseData, dlcData, level, introHtml } = Astro.props as Props;

const basename = EDITIONS.base.name;
const dlcname = EDITIONS.dlc.name;

const isRegionalTrait = introHtml && introHtml.includes('trait_00_regional') && introHtml.includes('地域特性');
---

{
    !baseData && !dlcData && !introHtml ? (
        <div>背景人物。</div>
    ) : (
        <>
            <SectionTitle>介绍</SectionTitle>
            {introHtml ? (
                <p>
                    {isRegionalTrait && (
                        <>
                            {baseData && basename}
                            {baseData && dlcData && '与'}
                            {dlcData && dlcname}中的
                        </>
                    )}
                    <span set:html={introHtml} />
                    {isRegionalTrait && '。'}
                </p>
            ) : (
                <p>
                    {baseData && basename}
                    {baseData && dlcData && '与'}
                    {dlcData && dlcname}中的
                    {level === 1 ? (
                        <a href="../trait_00_personal" style="color: #5bae23; text-shadow: 0 0 8px #5bae23, 0 0 12px #5bae23;">
                            顶级专属个人特性
                        </a>
                    ) : level === 2 ? (
                        <a href="../trait_00_personal" style="color: #5bae22;">
                            专属个人特性
                        </a>
                    ) : level === 3 ? (
                        <a href="../trait_00_personal" style="color: #de1c31;">
                            负面个人特性
                        </a>
                    ) : (
                        <a href="../trait_00_personal">个人特性</a>
                    )}
                    。
                </p>
            )}
        </>
    )
}
