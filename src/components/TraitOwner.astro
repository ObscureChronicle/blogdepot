---
type Props = {
    baseOwner: string[];
    dlcOwner: string[];
    collabOwner?: string[];
};

const { baseOwner, dlcOwner, collabOwner } = Astro.props as Props;

import SectionTitle from './SectionTitle.astro';
import EditionBadge from './EditionBadge.astro';
import LinkedNames from './LinkedNames.astro';
---

{
    (baseOwner && baseOwner.length > 0) || (dlcOwner && dlcOwner.length > 0) || (collabOwner && collabOwner.length > 0) ? (
        <>
            <SectionTitle>持有人</SectionTitle>
            <div class="flex flex-col pl-4 gap-4">
                {baseOwner && baseOwner.length > 0 && (
                    <div class="flex flex-col items-start">
                        <EditionBadge edition="base" />
                        <p class="text-base leading-relaxed">
                            <LinkedNames kind="character" names={baseOwner} />
                        </p>
                    </div>
                )}
                {dlcOwner && dlcOwner.length > 0 && (
                    <div class="flex flex-col items-start">
                        <EditionBadge edition="dlc" />
                        <p class="text-base leading-relaxed">
                            <LinkedNames kind="character" names={dlcOwner} />
                        </p>
                    </div>
                )}
                {collabOwner && collabOwner.length > 0 && (
                    <div class="flex flex-col items-start">
                        <EditionBadge edition="collab" />
                        <p class="text-base leading-relaxed">
                            <LinkedNames kind="character" names={collabOwner} />
                        </p>
                    </div>
                )}
            </div>
        </>
    ) : null
}
