---
import type { HTMLAttributes } from 'astro/types';

type AnchorProps = HTMLAttributes<'a'> & {
  type?: never;
  target?: '_blank' | '_self' | '_parent' | '_top' | string;
};
type ButtonProps = HTMLAttributes<'button'> & { href?: never };

type Props = AnchorProps | ButtonProps;

const props = Astro.props as Props;
const { class: className, ...rest } = props;

const buttonClasses =
  'btn-frame relative inline-flex items-center justify-center px-7 py-2.5 font-serif leading-tight text-main bg-main transition hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--border-main)]';

const isAnchor = 'href' in props;
---
{isAnchor ? (
  <a
    href={(props as AnchorProps).href}
    target={(props as AnchorProps).target}
    class:list={[buttonClasses, className]}
    {...rest}
  >
    <slot />
    {(props as AnchorProps).target === "_blank" && <img src="/up-right-arrow.png" class="w-[1em] h-[1em] ml-[5px] mb-[2px]"/>}
  </a>
) : (
  <button class:list={[buttonClasses, 'cursor-pointer', className]} {...rest}>
    <slot />
  </button>
)}

<style>
  /* 框线样式：两端满高粗竖条 + 主体上下内嵌细横线，颜色跟随主题边框色 */
  .btn-frame::before,
  .btn-frame::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }
  .btn-frame::before {
    inset: 0;
    border-inline: 3px solid var(--border-main);
  }
  .btn-frame::after {
    inset: 4px 7px;
    border-block: 1px solid var(--border-main);
  }
</style>
