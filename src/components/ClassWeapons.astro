---
import type { Edition } from '../data/editions';
import SectionTitle from './SectionTitle.astro';

type Props = {
    weapons?: string[];
    /** 兵种页按版本分区时的标题配色 */
    tone?: Edition;
};

const { weapons, tone } = Astro.props as Props;
---

{
    weapons && weapons.length > 0 ? (
        <>
            <SectionTitle tone={tone}>可装备武器</SectionTitle>
            <p class="text-base leading-relaxed">{weapons.join('、')}</p>
        </>
    ) : null
}
