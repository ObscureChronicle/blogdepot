---
// 兵种词条的字段列表：说明、可装备武器、兵种类型、兵种技能、兵种参数、兵种树。
// Layout_Classes 直接用它；Layout_ClassesPlus 在每个版本分区里各用一次（带 tone 着色）。
import type { Edition } from '../data/editions';
import ClassTree from './ClassTree.astro';
import SectionTitle from './SectionTitle.astro';

// 兵种参数：与装备页的 damageReduction 一样，按「组名 → { 名称: 数值 }」书写。
// 只写有数据的组与行，没写的自动隐藏。
export type ClassParams = Partial<Record<'基本参数' | '成长' | '伤害减免', Record<string, string | number>>>;

export type ClassData = {
    description?: string;
    weapons?: string[];
    classType?: string;
    skills?: string[];
    params?: ClassParams;
    parents?: string[];
    upgrades?: string[];
    condition?: string[];
};

type Props = {
    data: ClassData;
    /** 按版本分区时的标题配色 */
    tone?: Edition;
    /** 是否显示「说明」标题（版本分区里由分区大标题代替） */
    showDescriptionTitle?: boolean;
    /** 以下透传给 ClassTree，用于星命诀把「兵种树」等文案换成阵势相关的说法 */
    treeTitle?: string;
    upgradesLabel?: string;
    parentsLabel?: string;
    conditionLabel?: string;
};

const { data, tone, showDescriptionTitle = true, treeTitle, upgradesLabel, parentsLabel, conditionLabel } = Astro.props as Props;
const { description, weapons, classType, skills, params } = data;

// 参数分组顺序固定，组内顺序按数据书写顺序
const PARAM_GROUP_ORDER = ['基本参数', '成长', '伤害减免'] as const;

// 与 EquipmentStats 一致：正数前面加 +，负数着色为红色，其余为绿色
const formatParamValue = (value: string | number, isPercent: boolean) => {
    if (!isPercent || typeof value !== 'number') {
        return { display: value, tone: '' };
    }
    return {
        display: value > 0 ? `+${value}%` : `${value}%`,
        tone: value < 0 ? 'text-stat-neg' : 'text-stat-pos'
    };
};

// 没有数据的组与行都不渲染
const filledParamGroups = PARAM_GROUP_ORDER.map((title) => {
    const isPercent = title === '伤害减免';
    const rows = Object.entries(params?.[title] ?? {})
        .filter(([, value]) => value !== undefined && value !== null && value !== '')
        .map(([label, value]) => ({ label, ...formatParamValue(value, isPercent) }));
    return { title, isPercent, rows };
}).filter((group) => group.rows.length > 0);
---

{
    description && description.length > 0 && (
        <>
            {showDescriptionTitle && <SectionTitle>说明</SectionTitle>}
            <p set:html={description} class="text-base leading-relaxed" />
        </>
    )
}
{
    weapons && weapons.length > 0 && (
        <>
            <SectionTitle tone={tone}>可装备武器</SectionTitle>
            <p class="text-base leading-relaxed">{weapons.join('、')}</p>
        </>
    )
}
{
    classType && classType.length > 0 && (
        <>
            <SectionTitle tone={tone}>兵种类型</SectionTitle>
            <p class="text-base leading-relaxed">{classType}</p>
        </>
    )
}
{
    skills && skills.length > 0 && (
        <>
            <SectionTitle tone={tone}>兵种技能</SectionTitle>
            <p class="text-base leading-relaxed">{skills.join('、')}</p>
        </>
    )
}
{
    filledParamGroups.length > 0 && (
        <>
            <SectionTitle tone={tone}>兵种参数</SectionTitle>
            <table class="wiki-table wiki-table--hover not-prose mt-2 max-w-[30rem]">
                {filledParamGroups.map((group) => (
                    <tbody>
                        <tr>
                            <th scope="rowgroup" colspan={2}>
                                {group.title}
                            </th>
                        </tr>
                        {group.rows.map((row) => (
                            <tr>
                                <th scope="row" class="w-28">
                                    {row.label}
                                </th>
                                <td class:list={[group.isPercent && 'text-right font-semibold', row.tone]}>{row.display}</td>
                            </tr>
                        ))}
                    </tbody>
                ))}
            </table>
        </>
    )
}
<ClassTree
    parents={data.parents || []}
    upgrades={data.upgrades || []}
    condition={data.condition || []}
    tone={tone}
    treeTitle={treeTitle}
    upgradesLabel={upgradesLabel}
    parentsLabel={parentsLabel}
    conditionLabel={conditionLabel}
/>
