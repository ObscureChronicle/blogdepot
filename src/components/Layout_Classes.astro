---
type ClassWikiProps = {
    description?: string;
    weapons?: string[];
    classType?: string;
    skills?: string[];
    params?: { label: string; value: string | number }[];
    parents?: string[];
    upgrades?: string[];
    condition?: string[];
    baseOwner?: string[];
    dlcOwner?: string[];
};

const { description, weapons, classType, skills, params, parents, upgrades, condition, baseOwner, dlcOwner } = Astro.props as ClassWikiProps;

import ClassDescription from './ClassDescription.astro';
import ClassParams from './ClassParams.astro';
import ClassSkills from './ClassSkills.astro';
import ClassTree from './ClassTree.astro';
import ClassType from './ClassType.astro';
import ClassWeapons from './ClassWeapons.astro';
import TraitOwner from './TraitOwner.astro';
---

<ClassDescription description={description || ''} />
<ClassWeapons weapons={weapons || []} />
<ClassType classType={classType || ''} />
<ClassSkills skills={skills || []} />
<ClassParams params={params || []} />
<ClassTree parents={parents || []} upgrades={upgrades || []} condition={condition || []} />
<TraitOwner baseOwner={baseOwner || []} dlcOwner={dlcOwner || []} />
