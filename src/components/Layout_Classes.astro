---
type ClassWikiProps = {
    description?: string;
    weapons?: string[];
    classType?: string;
    skills?: string[];
    params?: { label: string; value: string | number }[];
    parents?: string[];
    upgrades?: string[];
    condition?: string[];
    baseOwner?: string[];
    dlcOwner?: string[];
};

const { description, weapons, classType, skills, params, parents, upgrades, condition, baseOwner, dlcOwner } = Astro.props as ClassWikiProps;

import ClassSection from './ClassSection.astro';
import TraitOwner from './TraitOwner.astro';
---

<TraitOwner baseOwner={baseOwner || []} dlcOwner={dlcOwner || []} />
<ClassSection data={{ description, weapons, classType, skills, params, parents, upgrades, condition }} />
