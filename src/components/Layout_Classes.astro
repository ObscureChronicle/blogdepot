---
import ClassSection, { type ClassParams } from './ClassSection.astro';
import TraitOwner from './TraitOwner.astro';

type ClassWikiProps = {
    description?: string;
    /** 说明正文：在 description 摘要之后逐段渲染 */
    terms?: string[];
    weapons?: string[];
    classType?: string;
    skills?: string[];
    params?: ClassParams;
    parents?: string[];
    upgrades?: string[];
    condition?: string[];
    baseOwner?: string[];
    dlcOwner?: string[];
};

const { description, terms, weapons, classType, skills, params, parents, upgrades, condition, baseOwner, dlcOwner } = Astro.props as ClassWikiProps;
---

<TraitOwner baseOwner={baseOwner || []} dlcOwner={dlcOwner || []} />
<ClassSection data={{ description, terms, weapons, classType, skills, params, parents, upgrades, condition }} />
