---
import type { Edition } from '../data/editions';
import SectionTitle from './SectionTitle.astro';

type Props = {
    skills?: string[];
    /** 兵种页按版本分区时的标题配色 */
    tone?: Edition;
};

const { skills, tone } = Astro.props as Props;
---

{
    skills && skills.length > 0 ? (
        <>
            <SectionTitle tone={tone}>兵种技能</SectionTitle>
            <p class="text-base leading-relaxed">{skills.join('、')}</p>
        </>
    ) : null
}
