---
type Props = {
    skills?: string[];
    titleClass?: string;
};

const { skills, titleClass } = Astro.props as Props;
---

{
    skills && skills.length > 0 ? (
        <>
            <h2 class={`${titleClass || 'bg-blue-100 text-blue-800 dark:bg-blue-200 dark:text-blue-800'} text-2xl font-bold px-2.5 pt-1.5 rounded-sm inline-block`}>兵种技能</h2>
            <p class="text-base leading-relaxed">{skills.join('、')}</p>
        </>
    ) : null
}
