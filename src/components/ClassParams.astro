---
type Props = {
    params?: { label: string; value: string | number }[];
    titleClass?: string;
};

const { params, titleClass } = Astro.props as Props;
---

{
    params && params.length > 0 ? (
        <>
            <h2 class={`${titleClass || 'bg-blue-100 text-blue-800 dark:bg-blue-200 dark:text-blue-800'} text-2xl font-bold px-2.5 pt-1.5 rounded-sm inline-block`}>兵种参数</h2>
            <div class="flex flex-col pl-4 gap-1">
                {params.map((p) => (
                    <p class="text-base leading-relaxed">
                        {p.label}：{p.value}
                    </p>
                ))}
            </div>
        </>
    ) : null
}
