---
// 配饰附诗总览表：名称 / 附诗（原文、本地化）。
// 构建时扫描写了本地化的词条；每首附诗单独成行，本地化跟行不跟词条。
// 本地化按 hant / ja / en 三份文本渲染，用 radio + CSS 切换，不引入水合脚本，
// 缺省文本显示「—」。
import EditionBadge from './EditionBadge.astro';
import { getTreasurePoemGroups, type TreasurePoemGroup } from '../utils/treasure-poems-data';

const groups = getTreasurePoemGroups().filter((group) => group.rows.length > 0);

const rowsOf = (group: TreasurePoemGroup, edition: 'base' | 'dlc') => group.rows.filter((row) => row.editions.includes(edition));

// 本传与星命诀都有附诗、且不是每行都同时属于两版时，用版本标签区分
const showEditions = (group: TreasurePoemGroup) => {
    const base = rowsOf(group, 'base');
    const dlc = rowsOf(group, 'dlc');
    if (base.length === 0 || dlc.length === 0) return false;
    return !(base.length === dlc.length && group.rows.every((row) => row.editions.length === 2));
};

const localized = (text?: string) => (text && text.trim() ? text.trim() : '—');
---

<div class="treasure-poems not-prose my-4">
    <fieldset class="mb-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        <legend class="sr-only">本地化语言</legend>
        <label class="flex cursor-pointer items-center gap-1.5">
            <input type="radio" name="treasure-poem-lang" value="hant" checked />
            繁體字
        </label>
        <label class="flex cursor-pointer items-center gap-1.5">
            <input type="radio" name="treasure-poem-lang" value="ja" />
            日本語
        </label>
        <label class="flex cursor-pointer items-center gap-1.5">
            <input type="radio" name="treasure-poem-lang" value="en" />
            English
        </label>
    </fieldset>

    <div class="overflow-x-auto">
        <table class="wiki-table wiki-table--hover min-w-[32rem]">
            <thead>
                <tr>
                    <th scope="col" rowspan="2" class="whitespace-nowrap">名称</th>
                    <th scope="colgroup" colspan="2">附诗</th>
                </tr>
                <tr>
                    <th scope="col">原文</th>
                    <th scope="col">本地化</th>
                </tr>
            </thead>
            <tbody>
                {
                    groups.map((group) =>
                        group.rows.map((row, index) => (
                            <tr>
                                {index === 0 && (
                                    <th scope="row" rowspan={group.rows.length} class="whitespace-nowrap align-top">
                                        <a href={`/projects/treasure/${group.slug}/`} class="hover:underline">
                                            {group.title || group.slug}
                                        </a>
                                    </th>
                                )}
                                <td>
                                    {showEditions(group) && (
                                        <div class="mb-1 flex flex-wrap gap-1">
                                            {row.editions.map((edition) => (
                                                <EditionBadge edition={edition} />
                                            ))}
                                        </div>
                                    )}
                                    <p class="whitespace-pre-line">{row.text}</p>
                                </td>
                                <td>
                                    <span data-poem-lang="hant" class="whitespace-pre-line">
                                        {localized(row.hant)}
                                    </span>
                                    <span data-poem-lang="ja" class="whitespace-pre-line">
                                        {localized(row.ja)}
                                    </span>
                                    <span data-poem-lang="en" class="whitespace-pre-line">
                                        {localized(row.en)}
                                    </span>
                                </td>
                            </tr>
                        ))
                    )
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .treasure-poems [data-poem-lang] {
        display: none;
    }

    .treasure-poems:has(input[value='hant']:checked) [data-poem-lang='hant'],
    .treasure-poems:has(input[value='ja']:checked) [data-poem-lang='ja'],
    .treasure-poems:has(input[value='en']:checked) [data-poem-lang='en'] {
        display: inline;
    }
</style>
