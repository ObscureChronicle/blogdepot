---
// 配饰附诗总览表：名称 / 附诗（原文、本地化）。
// 原文在构建时从词条 MDX 读取；本地化按 hant / ja / en 三份文本渲染，
// 用 radio + CSS 切换，不引入水合脚本，缺省文本显示「—」。
import EditionBadge from './EditionBadge.astro';
import { getTreasurePoemRows, type TreasurePoemRow } from '../utils/treasure-poems-data';

// 类型页没有附诗，只作为本地化占位数据保留，不进入表格
const rows = getTreasurePoemRows().filter((row) => row.base.length > 0 || row.dlc.length > 0);

const samePoems = (a: string[], b: string[]) => a.length === b.length && a.every((poem, i) => poem === b[i]);
const editionsDiffer = (row: TreasurePoemRow) => row.base.length > 0 && row.dlc.length > 0 && !samePoems(row.base, row.dlc);
const localized = (text?: string) => (text && text.trim() ? text.trim() : '—');
const poemsOf = (row: TreasurePoemRow) => (row.base.length > 0 ? row.base : row.dlc);
---

<div class="treasure-poems not-prose my-4">
    <fieldset class="mb-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        <legend class="sr-only">本地化语言</legend>
        <label class="flex cursor-pointer items-center gap-1.5">
            <input type="radio" name="treasure-poem-lang" value="hant" checked />
            繁體字
        </label>
        <label class="flex cursor-pointer items-center gap-1.5">
            <input type="radio" name="treasure-poem-lang" value="ja" />
            日本語
        </label>
        <label class="flex cursor-pointer items-center gap-1.5">
            <input type="radio" name="treasure-poem-lang" value="en" />
            English
        </label>
    </fieldset>

    <div class="overflow-x-auto">
        <table class="wiki-table wiki-table--hover min-w-[32rem]">
            <thead>
                <tr>
                    <th scope="col" rowspan="2" class="whitespace-nowrap">名称</th>
                    <th scope="colgroup" colspan="2">附诗</th>
                </tr>
                <tr>
                    <th scope="col">原文</th>
                    <th scope="col">本地化</th>
                </tr>
            </thead>
            <tbody>
                {
                    rows.map((row) => (
                        <tr>
                            <th scope="row" class="whitespace-nowrap">
                                <a href={`/projects/treasure/${row.slug}/`} class="hover:underline">
                                    {row.title || row.slug}
                                </a>
                            </th>
                            <td>
                                {editionsDiffer(row) ? (
                                    <div class="space-y-2">
                                        <div>
                                            <EditionBadge edition="base" />
                                            <p class="mt-1 whitespace-pre-line">{row.base.join('\n')}</p>
                                        </div>
                                        <div>
                                            <EditionBadge edition="dlc" />
                                            <p class="mt-1 whitespace-pre-line">{row.dlc.join('\n')}</p>
                                        </div>
                                    </div>
                                ) : (
                                    <p class="whitespace-pre-line">{poemsOf(row).join('\n')}</p>
                                )}
                            </td>
                            <td>
                                <span data-poem-lang="hant" class="whitespace-pre-line">
                                    {localized(row.hant)}
                                </span>
                                <span data-poem-lang="ja" class="whitespace-pre-line">
                                    {localized(row.ja)}
                                </span>
                                <span data-poem-lang="en" class="whitespace-pre-line">
                                    {localized(row.en)}
                                </span>
                            </td>
                        </tr>
                    ))
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .treasure-poems [data-poem-lang] {
        display: none;
    }

    .treasure-poems:has(input[value='hant']:checked) [data-poem-lang='hant'],
    .treasure-poems:has(input[value='ja']:checked) [data-poem-lang='ja'],
    .treasure-poems:has(input[value='en']:checked) [data-poem-lang='en'] {
        display: inline;
    }
</style>
