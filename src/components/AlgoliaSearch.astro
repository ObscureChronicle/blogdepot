---
// Algolia（Netlify 插件版）站内搜索框，嵌在页面里（目前只在百科首页使用）。
// 脚本和样式只在用到搜索框的页面加载；顶栏的全局搜索见 NavSearch.astro。
import { thirdParty } from '../data/site-config';

type Props = { class?: string };

const { class: className } = Astro.props;
---

<link rel="stylesheet" href={thirdParty.algolia.styleUrl} />
<div id="search" class={className}></div>

<script>
    import { mountAlgolia } from '../utils/algolia-client';

    document.addEventListener('astro:page-load', () => {
        const el = document.querySelector<HTMLElement>('#search');
        if (el) void mountAlgolia(el);
    });
</script>
